+	const fixture: McpToolCandidate[] = [{ server: serverEntry, name: "search" }];
+	const approval = broker(decision);
+	return {
+		approval,
+		approvedForSession,
+		invoke: () =>
+			approveMcpToolCall({
+				server: serverEntry,
+				toolName: "search",
+				publicName: "docs_search",
+				args,
