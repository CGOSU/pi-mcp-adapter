+
+export type McpManagementCapability = (typeof MCP_MANAGEMENT_CAPABILITIES)[number];
+export type McpManagementDirectTools = boolean | readonly string[];
+export type McpManagementConnectionStatus =
+	| "disabled"
+	| "starting"
+	| "connecting"
+	| "connected"
+	| "disconnected"
+	| "needs-auth"
