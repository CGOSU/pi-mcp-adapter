+import type { McpClient } from "@earendil-works/pi-mcp";
+import { JSON_RPC_ERROR_CODES, McpError } from "@earendil-works/pi-mcp";
+import type { ExtensionUIContext } from "../../core/extensions/types.ts";
+
+export type McpElicitationValue = string | number | boolean | string[] | undefined;
+
+type ElicitationSchema = {
+	readonly type: "object";
+	readonly properties: Readonly<Record<string, Record<string, unknown>>>;
+	readonly required?: readonly string[];
+};
+
+type FieldCollectionResult =
+	| { readonly status: "cancelled" }
+	| { readonly status: "collected"; readonly value: McpElicitationValue };
+
+export interface McpElicitationHandlerOptions {
+	readonly serverName: string;
+	readonly ui?: Pick<ExtensionUIContext, "select" | "input" | "notify">;
+	readonly allowUrl: boolean;
+	readonly openUrl: (url: string) => void;
+	readonly onUrlAccepted?: (elicitationId: string) => void;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function invalidParams(message: string): McpError {
+	return new McpError(JSON_RPC_ERROR_CODES.invalidParams, message);
+}
+
+function safeUiText(value: string): string {
+	return value
+		.replace(/\x1b\][^\x07]*(?:\x07|\x1b\\)/g, "")
+		.replace(/(?:\x1b\[[0-?]*[ -/]*[@-~]|\x1b[@-Z\\-_])/g, "")
+		.replace(/[\u0000-\u001f\u007f-\u009f]/g, " ");
+}
+
+function awaitWithSignal<T>(promise: Promise<T>, signal: AbortSignal): Promise<T> {
+	if (signal.aborted)
+		return Promise.reject(
+			signal.reason instanceof Error ? signal.reason : new Error("MCP elicitation was cancelled."),
+		);
+	let onAbort: (() => void) | undefined;
+	return Promise.race([
+		promise,
+		new Promise<T>((_resolve, reject) => {
+			onAbort = () =>
+				reject(signal.reason instanceof Error ? signal.reason : new Error("MCP elicitation was cancelled."));
+			signal.addEventListener("abort", onAbort, { once: true });
+		}),
+	]).finally(() => {
+		if (onAbort) signal.removeEventListener("abort", onAbort);
+	});
+}
+
