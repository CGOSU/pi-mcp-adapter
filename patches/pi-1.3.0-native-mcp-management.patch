+				publicName: "docs_search",
+				args: { a: 2, z: 1 },
+				origin: "direct",
+				allTools: [{ server: server(), name: "search" }],
+				events: fixture.approval.events,
+				approvedForSession: fixture.approvedForSession,
+			}),
+		).toEqual({ allowed: true });
+		expect(fixture.approval.requests).toBe(1);
