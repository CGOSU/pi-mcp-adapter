+	const stack = [...(childrenByParent.get(rootPid) ?? [])];
+	while (stack.length > 0) {
+		const pid = stack.pop()!;
+		processPids.add(pid);
+		stack.push(...(childrenByParent.get(pid) ?? []));
+	}
+	return [...processPids];
+}
