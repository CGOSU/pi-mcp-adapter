+		"title",
+		"description",
+		"default",
+		"enum",
+		"enumNames",
+		"oneOf",
+		"items",
+		"format",
+		"minLength",
+		"maxLength",
+		"minimum",
+		"maximum",
+		"minItems",
+		"maxItems",
+		"uniqueItems",
+	]);
+	const stringArray = (candidate: unknown, maxItems = 256): candidate is string[] =>
+		Array.isArray(candidate) && candidate.length <= maxItems && candidate.every((item) => typeof item === "string");
+	for (const [name, schema] of entries) {
+		if (
