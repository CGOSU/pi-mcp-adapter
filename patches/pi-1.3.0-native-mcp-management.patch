--- /dev/null
+++ b/packages/mcp/src/transports/sse.ts
@@ -0,0 +1,290 @@
+import type { AuthProvider, McpFetch } from "../auth-provider.ts";
+import {
+	type JsonRpcMessage,
+	McpAbortError,
+	McpConnectionClosedError,
+	parseJsonRpcMessage,
+} from "../protocol/jsonrpc.ts";
+import { McpAuthRequiredError, McpHttpError } from "./streamable-http.ts";
+import {
+	DEFAULT_MAX_MESSAGE_BYTES,
+	type McpTransport,
+	type McpTransportSendOptions,
+	TransportEvents,
+} from "./transport.ts";
+
+const DEFAULT_CONNECT_TIMEOUT_MS = 30_000;
+
+export interface SseTransportOptions {
+	url: string | URL;
+	headers?: Record<string, string>;
+	fetch?: McpFetch;
+	authProvider?: AuthProvider;
+	maxMessageBytes?: number;
+	connectTimeoutMs?: number;
+}
+
+interface SseEvent {
+	event?: string;
+	data: string;
+}
+
+function contentType(response: Response): string | undefined {
+	return response.headers.get("content-type")?.split(";", 1)[0]?.trim().toLowerCase();
+}
+
+function needsAuthorization(response: Response): boolean {
+	if (response.status === 401) return true;
+	return (
+		response.status === 403 &&
+		/(?:^|[\s,])error="?insufficient_scope"?/i.test(response.headers.get("www-authenticate") ?? "")
+	);
+}
+
+async function discard(response: Response): Promise<void> {
+	await response.body?.cancel().catch(() => undefined);
+}
+
+async function consumeSse(
+	stream: ReadableStream<Uint8Array>,
+	maxEventBytes: number,
+	onEvent: (event: SseEvent) => void,
+): Promise<void> {
+	const reader = stream.getReader();
+	const decoder = new TextDecoder();
+	let buffer = "";
+	let data: string[] = [];
+	let eventName: string | undefined;
+	let eventBytes = 0;
+	const dispatch = () => {
+		if (data.length > 0) onEvent({ event: eventName, data: data.join("\n") });
+		data = [];
+		eventName = undefined;
+		eventBytes = 0;
+	};
+	const processLine = (line: string) => {
+		if (line === "") {
+			dispatch();
+			return;
+		}
+		if (line.startsWith(":")) return;
+		const colon = line.indexOf(":");
+		const field = colon < 0 ? line : line.slice(0, colon);
+		const value = colon < 0 ? "" : line.slice(colon + 1).replace(/^ /, "");
+		eventBytes += Buffer.byteLength(line) + 1;
+		if (eventBytes > maxEventBytes) throw new Error(`MCP SSE event exceeds ${maxEventBytes} bytes`);
+		if (field === "event") eventName = value;
+		else if (field === "data") data.push(value);
+	};
+	try {
+		while (true) {
+			const { done, value } = await reader.read();
+			if (done) break;
+			buffer += decoder.decode(value, { stream: true });
+			let newline = buffer.indexOf("\n");
+			while (newline >= 0) {
+				processLine(buffer.slice(0, newline).replace(/\r$/, ""));
+				buffer = buffer.slice(newline + 1);
+				newline = buffer.indexOf("\n");
+			}
+			if (Buffer.byteLength(buffer) + eventBytes > maxEventBytes) {
+				throw new Error(`MCP SSE event exceeds ${maxEventBytes} bytes`);
+			}
+		}
+		buffer += decoder.decode();
+		if (buffer) processLine(buffer.replace(/\r$/, ""));
+		dispatch();
+	} finally {
+		reader.releaseLock();
+	}
+}
+
+/** Legacy HTTP+SSE MCP transport. SSE is selected explicitly or by native compatibility detection. */
+export class SseTransport extends TransportEvents implements McpTransport {
+	readonly url: URL;
+	readonly options: SseTransportOptions;
+	private readonly fetch: McpFetch;
+	private readonly controller = new AbortController();
+	private started = false;
+	private closed = false;
+	private endpoint: URL | undefined;
+	private streamTask: Promise<void> | undefined;
+	private resolveEndpoint!: (endpoint: URL) => void;
+	private rejectEndpoint!: (error: Error) => void;
+	private endpointReady: Promise<URL>;
+
+	constructor(options: SseTransportOptions) {
+		super();
+		this.options = options;
+		this.url = new URL(options.url);
+		const fetch = options.fetch ?? globalThis.fetch;
+		this.fetch = (input, init) => fetch(input, init);
+		this.endpointReady = new Promise<URL>((resolve, reject) => {
+			this.resolveEndpoint = resolve;
+			this.rejectEndpoint = reject;
+		});
+	}
+
+	async start(): Promise<void> {
+		if (this.started) throw new Error("MCP SSE transport already started");
+		if (this.closed) throw new McpConnectionClosedError();
+		this.started = true;
+		const timeoutMs = this.options.connectTimeoutMs ?? DEFAULT_CONNECT_TIMEOUT_MS;
+		const connectController = new AbortController();
+		const connectSignal = AbortSignal.any([this.controller.signal, connectController.signal]);
+		const connectTimer = setTimeout(() => connectController.abort(), timeoutMs);
+		const endpointTimer = setTimeout(
+			() => this.rejectEndpoint(new Error(`MCP SSE endpoint was not announced within ${timeoutMs}ms`)),
+			timeoutMs,
+		);
+		try {
+			const response = await this.authorizedFetch(
+				this.url,
+				"GET",
+				{ accept: "text/event-stream" },
+				undefined,
+				connectSignal,
+			);
+			await this.checkResponse(response);
+			clearTimeout(connectTimer);
+			if (contentType(response) !== "text/event-stream" || !response.body) {
+				await discard(response);
+				throw new McpHttpError(response.status, "MCP SSE endpoint did not return an event stream");
+			}
+			this.streamTask = this.readServerStream(response.body);
+			await this.endpointReady;
+		} catch (error) {
+			this.rejectEndpoint(error instanceof Error ? error : new Error("MCP SSE endpoint setup failed"));
+			throw error;
+		} finally {
+			clearTimeout(connectTimer);
+			clearTimeout(endpointTimer);
+		}
+	}
+
+	async send(message: JsonRpcMessage, { signal }: McpTransportSendOptions = {}): Promise<void> {
+		if (!this.started || this.closed) throw new McpConnectionClosedError();
+		const requestSignal = signal ?? this.controller.signal;
+		if (requestSignal.aborted) throw new McpAbortError();
+		const endpoint = await this.endpointReady;
+		if (requestSignal.aborted) throw new McpAbortError();
+		const response = await this.authorizedFetch(
+			endpoint,
+			"POST",
+			{ accept: "application/json, text/event-stream", "content-type": "application/json" },
+			JSON.stringify(message),
+			requestSignal,
+		);
+		await this.checkResponse(response);
+		if (response.status === 202 || response.status === 204) {
+			await discard(response);
+			return;
+		}
+		const type = contentType(response);
+		if (type === "application/json") {
+			const value: unknown = await response.json();
+			for (const item of Array.isArray(value) ? value : [value]) this.emitMessage(parseJsonRpcMessage(item));
+			return;
+		}
+		if (type === "text/event-stream" && response.body) {
+			await consumeSse(response.body, this.maxMessageBytes(), (event) => this.consumeMessageEvent(event));
+			return;
+		}
+		await discard(response);
+		throw new McpHttpError(response.status, `Unsupported MCP SSE POST response content type: ${type ?? "missing"}`);
+	}
+
+	async close(): Promise<void> {
+		if (this.closed) return;
+		this.closed = true;
+		this.controller.abort();
+		this.rejectEndpoint(new McpConnectionClosedError());
+		await this.streamTask?.catch(() => undefined);
+		this.emitClose();
+	}
+
+	private async authorizedFetch(
+		url: URL,
+		method: "GET" | "POST",
+		extraHeaders: Record<string, string>,
+		body: string | undefined,
+		signal: AbortSignal,
+	): Promise<Response> {
+		for (let attempt = 0; ; attempt++) {
+			const headers = new Headers(this.options.headers);
+			for (const [name, value] of Object.entries(extraHeaders)) headers.set(name, value);
+			const token = await this.options.authProvider?.token();
+			if (signal.aborted) throw new McpAbortError();
+			if (token) headers.set("Authorization", `Bearer ${token}`);
+			const response = await this.fetch(url, {
+				method,
+				headers,
+				...(body === undefined ? {} : { body }),
+				signal: AbortSignal.any([this.controller.signal, signal]),
+			});
+			if (attempt > 0 || !this.options.authProvider?.onUnauthorized || !needsAuthorization(response))
+				return response;
+			try {
+				await this.options.authProvider.onUnauthorized({ response, serverUrl: this.url, fetch: this.fetch, token });
+			} finally {
+				await discard(response);
+			}
+		}
+	}
+
+	private async checkResponse(response: Response): Promise<void> {
+		if (response.ok) return;
+		const body = (await response.text().catch(() => "")).slice(0, 4_096);
+		if (response.status === 401) throw new McpAuthRequiredError(response, body);
+		throw new McpHttpError(response.status, `MCP HTTP request failed with status ${response.status}`, body);
+	}
+
+	private async readServerStream(stream: ReadableStream<Uint8Array>): Promise<void> {
+		try {
+			await consumeSse(stream, this.maxMessageBytes(), (event) => {
+				if (event.event === "endpoint") {
+					this.acceptEndpoint(event.data);
+					return;
+				}
+				this.consumeMessageEvent(event);
+			});
+			if (!this.endpoint)
+				this.rejectEndpoint(new Error("MCP SSE stream ended before it announced a message endpoint"));
+			if (!this.closed) this.emitClose();
+		} catch (error) {
+			if (!this.endpoint) this.rejectEndpoint(error instanceof Error ? error : new Error("MCP SSE stream failed"));
+			if (!this.closed) this.emitError(error);
+		}
+	}
+
+	private acceptEndpoint(value: string): void {
+		let endpoint: URL;
+		try {
+			endpoint = new URL(value, this.url);
+		} catch {
+			this.rejectEndpoint(new Error("MCP SSE stream announced an invalid message endpoint"));
+			return;
+		}
+		if (endpoint.origin !== this.url.origin || endpoint.username || endpoint.password || endpoint.hash) {
+			this.rejectEndpoint(new Error("MCP SSE message endpoint must remain on the configured server origin"));
+			return;
+		}
+		if (!this.endpoint) {
+			this.endpoint = endpoint;
+			this.resolveEndpoint(endpoint);
+		}
+	}
+
+	private consumeMessageEvent(event: SseEvent): void {
+		if (!event.data.trim() || (event.event !== undefined && event.event !== "message")) return;
+		try {
+			this.emitMessage(parseJsonRpcMessage(JSON.parse(event.data)));
+		} catch (error) {
+			this.emitError(error);
+		}
+	}
+
+	private maxMessageBytes(): number {
+		return this.options.maxMessageBytes ?? DEFAULT_MAX_MESSAGE_BYTES;
+	}
+}
