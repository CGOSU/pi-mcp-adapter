@@ -0,0 +1,87 @@
+import { type JsonRpcMessage, LATEST_PROTOCOL_VERSION } from "@earendil-works/pi-mcp";
+import { createInMemoryTransportPair } from "@earendil-works/pi-mcp/testing";
+import { afterEach, describe, expect, it } from "vitest";
+import { InMemoryAuthStorageBackend } from "../src/core/auth-storage.ts";
+import type { McpServerEntry } from "../src/extensions/mcp/config.ts";
+import { McpOAuthCredentialStore, McpServerConnection } from "../src/extensions/mcp/runtime.ts";
+
+const connections: McpServerConnection[] = [];
+const executionPolicy: NonNullable<McpServerEntry["executionPolicy"]> = { sampling: true, elicitation: true };
+
+afterEach(async () => {
+	await Promise.all(connections.splice(0).map((connection) => connection.close()));
+});
+
+async function connect(
+	policy: NonNullable<McpServerEntry["executionPolicy"]>,
+	options: {
+		ui?: ConstructorParameters<typeof McpServerConnection>[0]["ui"];
+		allowUrlElicitation?: boolean;
+	} = {},
+): Promise<{ capabilities?: Record<string, unknown> } | undefined> {
+	const pair = createInMemoryTransportPair();
+	let initializeParams: { capabilities?: Record<string, unknown> } | undefined;
+	pair.server.onMessage((message) => {
+		if (!("id" in message) || !("method" in message)) return;
+		if (message.method === "initialize" && "params" in message) {
+			initializeParams = message.params as typeof initializeParams;
+		}
+		const response: JsonRpcMessage =
+			message.method === "initialize"
+				? {
+						jsonrpc: "2.0",
+						id: message.id,
+						result: {
+							protocolVersion: LATEST_PROTOCOL_VERSION,
+							capabilities: { tools: {} },
+							serverInfo: { name: "fixture", version: "1.0.0" },
+						},
+					}
+				: message.method === "tools/list"
+					? { jsonrpc: "2.0", id: message.id, result: { tools: [] } }
+					: { jsonrpc: "2.0", id: message.id, error: { code: -32601, message: "Method not found" } };
+		queueMicrotask(() => void pair.server.send(response));
+	});
+	void pair.server.start();
+
+	const connection = new McpServerConnection({
+		entry: { name: "fixture", config: { command: "unused" }, executionPolicy: policy, source: "test" },
+		cwd: process.cwd(),
+		createTransport: () => pair.client,
+		credentials: new McpOAuthCredentialStore(new InMemoryAuthStorageBackend()),
+		onTools: () => {},
+		...options,
+	});
+	connections.push(connection);
+	await connection.getClient();
+	return initializeParams;
+}
+
+describe("native MCP interaction capabilities", () => {
+	it("does not advertise sampling or elicitation in a headless session by default", async () => {
+		const params = await connect(executionPolicy);
+
+		expect(params?.capabilities?.sampling).toBeUndefined();
+		expect(params?.capabilities?.elicitation).toBeUndefined();
+	});
+
+	it("advertises only explicitly auto-approved sampling in a headless session", async () => {
+		const params = await connect({ ...executionPolicy, samplingAutoApprove: true });
+
+		expect(params?.capabilities?.sampling).toEqual({});
+		expect(params?.capabilities?.elicitation).toBeUndefined();
+	});
+
+	it("advertises sampling and form elicitation when an interactive UI is available", async () => {
+		const ui: NonNullable<ConstructorParameters<typeof McpServerConnection>[0]["ui"]> = {
+			confirm: async () => true,
+			select: async () => undefined,
+			input: async () => undefined,
+			notify: () => {},
+		};
+		const params = await connect(executionPolicy, { ui });
+
+		expect(params?.capabilities?.sampling).toEqual({});
+		expect(params?.capabilities?.elicitation).toEqual({ form: {} });
+	});
+});
