+		});
+		expect(installMcpOwnerAssembly({ credentialsBackend: {} } as unknown as McpOwnerAssembly)).toMatchObject({
+			ok: false,
+			error: { code: "invalid-assembly", message: expect.stringContaining("withLock") },
+		});
