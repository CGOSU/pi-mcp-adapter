+		expect(outcomes).toEqual([
+			{ ok: true, value: undefined },
+			{ ok: true, value: undefined },
+		]);
+		expect(result.transportCount()).toBe(1);
+		expect(snapshot(result.handle)[0]).toMatchObject({
+			connectionStatus: "connected",
+			catalog: { freshness: "live" },
+		});
+	});
+
+	it("connects a cached lazy server when a tool consumer first reaches it without executing cached metadata", async () => {
+		const entry: McpServerEntry = {
+			name: "docs",
+			config: { command: "fixture", lifecycle: "lazy" },
+			source: "fixture",
+		};
+		const result = await setup({ entries: [entry], seed: true });
+		expect(result.transportCount()).toBe(0);
+		expect(result.host.tools.has("mcp__docs__search")).toBe(false);
+		result.host.tools.set("tool_search", {
+			name: "tool_search",
+			reachesTools: () => ["mcp__docs"],
