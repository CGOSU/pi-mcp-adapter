+/** Emits session availability without exposing server state or configuration. */
+export function emitMcpManagementAvailability(events: EventBus, available: boolean): void {
+	const event: McpManagementAvailabilityEvent = Object.freeze({
+		protocol: MCP_MANAGEMENT_PROTOCOL_ID,
+		version: MCP_MANAGEMENT_PROTOCOL_VERSION,
+		available,
+		capabilities: MCP_MANAGEMENT_CAPABILITIES,
+	});
