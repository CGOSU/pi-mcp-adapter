+}
+
+export interface McpManagementOutputGuardPolicy {
+	readonly maxBytes?: number;
+	readonly maxLines?: number;
+	readonly detailsMaxBytes?: number;
+}
+
+/** Session-scoped adapter policy; native Pi exposure, project trust, and permissions still apply. */
+export interface McpManagementExecutionPolicy {
+	readonly directTools?: McpManagementDirectTools;
+	readonly includeTools?: readonly string[];
+	readonly excludeTools?: readonly string[];
