+			return `server "${name}": pluginDataDir must be a string`;
+		}
+		if (httpTransport !== undefined) return `server "${name}": httpTransport requires an HTTP URL`;
 		return value as unknown as McpStdioServerConfig;
 	}
-	return `server "${name}" needs either "command" (stdio) or "url" (streamable HTTP)`;
+	return `server "${name}" needs exactly one of command (stdio), url (HTTP), or socket`;
 }
 
 /** A server an extension registered with `pi.registerMcpServer()`. */
diff --git a/packages/coding-agent/src/extensions/mcp/approval.ts b/packages/coding-agent/src/extensions/mcp/approval.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7fe1fe9f86e8f01daa110aa87668653b7d63f54b
--- /dev/null
+++ b/packages/coding-agent/src/extensions/mcp/approval.ts
@@ -0,0 +1,190 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { ExtensionUIContext } from "../../core/extensions/types.ts";
+import type { McpServerEntry } from "./config.ts";
+import { formatAdapterToolName, isMcpToolAllowed, type McpToolCandidate } from "./execution-policy.ts";
+
+export const MCP_TOOL_APPROVAL_REQUEST_EVENT = "pi-mcp-adapter:tool-approval-request";
+
+export type McpToolApprovalDecision = "allow_once" | "allow_for_session" | "deny" | "abstain";
+export type McpToolApprovalOrigin = "direct" | "script" | "resource";
+export type McpToolApprovalHandler = () => McpToolApprovalDecision | Promise<McpToolApprovalDecision>;
+
+export interface McpToolApprovalRequest {
+	readonly requestId: string;
+	readonly serverName: string;
+	readonly originalToolName: string;
+	readonly prefixedToolName: string;
+	readonly args: Record<string, unknown>;
+	readonly origin: McpToolApprovalOrigin;
+	readonly signal?: AbortSignal;
+	claim(handler: McpToolApprovalHandler): boolean;
+}
+
+export interface McpApprovalEvents {
+	emit(event: string, data: unknown): void;
+}
+
+export interface McpApprovalResult {
+	readonly allowed: boolean;
+	readonly reason?: "denied" | "approval-required-headless";
+}
+
+function stableStringify(value: unknown): string {
+	if (value === null || value === undefined || typeof value !== "object") {
+		const serialized = JSON.stringify(value);
+		return serialized === undefined ? "undefined" : serialized;
+	}
+	if (Array.isArray(value)) return `[${value.map(stableStringify).join(",")}]`;
+	return `{${Object.keys(value as Record<string, unknown>)
+		.sort()
+		.map((key) => `${JSON.stringify(key)}:${stableStringify((value as Record<string, unknown>)[key])}`)
+		.join(",")}}`;
+}
+
+function approvalRequired(server: McpServerEntry, toolName: string, allTools: readonly McpToolCandidate[]): boolean {
+	const approval = server.executionPolicy?.approveTools;
+	if (approval === true) return true;
+	if (!Array.isArray(approval) || approval.length === 0) return false;
+	return (
+		isMcpToolAllowed(server, toolName, allTools, false) &&
+		approval.some((pattern) => matchesName(server.name, toolName, pattern, server))
+	);
+}
+
+function matchesName(server: string, toolName: string, pattern: string, entry: McpServerEntry): boolean {
+	if (pattern === `${server}/${toolName}`) return true;
+	const names = new Set([toolName]);
+	for (const mode of [entry.executionPolicy?.toolPrefix ?? "server", "server", "short", "mcp"] as const) {
+		names.add(formatAdapterToolName(server, toolName, { toolPrefix: mode }));
+	}
+	const legacyName = toolName.replace(/-/g, "_");
+	names.add(legacyName);
+	for (const mode of [entry.executionPolicy?.toolPrefix ?? "server", "server", "short", "mcp"] as const) {
+		names.add(formatAdapterToolName(server, legacyName, { toolPrefix: mode }));
+	}
+	if (names.has(pattern)) return true;
+	if (!/[*?]/.test(pattern)) return false;
+	const escaped = pattern
+		.replace(/[.+^${}()|[\]\\]/g, "\\$&")
+		.replace(/\*/g, ".*")
+		.replace(/\?/g, ".");
+	const expression = new RegExp(`^${escaped}$`);
+	return [...names].some((name) => expression.test(name));
+}
+
+function sanitizePromptText(value: string): string {
+	return value
+		.replace(/\x1b\][^\x07]*(?:\x07|\x1b\\)/g, "")
+		.replace(/(?:\x1b\[[0-?]*[ -/]*[@-~]|\x1b[@-Z\\-_])/g, "")
+		.replace(/[\u0000-\u001f\u007f-\u009f]/g, " ");
+}
+
+function abortError(signal: AbortSignal): Error {
+	return signal.reason instanceof Error
+		? signal.reason
+		: Object.assign(new Error("MCP tool approval was cancelled."), { name: "AbortError" });
+}
+
+async function awaitApproval<T>(value: Promise<T>, signal?: AbortSignal): Promise<T> {
+	if (!signal) return value;
+	if (signal.aborted) throw abortError(signal);
+	let onAbort: (() => void) | undefined;
+	try {
+		return await Promise.race([
+			value,
+			new Promise<T>((_resolve, reject) => {
+				onAbort = () => reject(abortError(signal));
+				signal.addEventListener("abort", onAbort, { once: true });
+			}),
+		]);
+	} finally {
+		if (onAbort) signal.removeEventListener("abort", onAbort);
+	}
+}
+
+async function brokerDecision(
+	events: McpApprovalEvents,
+	server: McpServerEntry,
+	toolName: string,
+	publicName: string,
+	args: Record<string, unknown>,
+	origin: McpToolApprovalOrigin,
+	signal?: AbortSignal,
+): Promise<McpToolApprovalDecision> {
+	let acceptingClaim = true;
+	let handler: McpToolApprovalHandler | undefined;
+	const request: McpToolApprovalRequest = {
+		requestId: randomUUID(),
+		serverName: server.name,
+		originalToolName: toolName,
+		prefixedToolName: publicName,
+		args,
+		origin,
+		...(signal ? { signal } : {}),
+		claim(candidate) {
+			if (!acceptingClaim || handler || typeof candidate !== "function") return false;
+			handler = candidate;
+			return true;
+		},
+	};
+	try {
+		events.emit(MCP_TOOL_APPROVAL_REQUEST_EVENT, request);
+	} finally {
+		acceptingClaim = false;
+	}
+	if (!handler) return "abstain";
+	try {
+		const decision = await awaitApproval(Promise.resolve().then(handler), signal);
+		return decision === "allow_once" ||
+			decision === "allow_for_session" ||
+			decision === "deny" ||
+			decision === "abstain"
+			? decision
+			: "deny";
+	} catch (error) {
+		if (signal?.aborted) throw error;
+		return "deny";
+	}
+}
+
+export async function approveMcpToolCall(options: {
+	server: McpServerEntry;
+	toolName: string;
+	publicName: string;
+	args: Record<string, unknown>;
+	origin: McpToolApprovalOrigin;
+	allTools: readonly McpToolCandidate[];
+	events: McpApprovalEvents;
+	ui?: Pick<ExtensionUIContext, "select">;
+	approvedForSession: Map<string, true>;
+	signal?: AbortSignal;
+}): Promise<McpApprovalResult> {
+	const { server, toolName, publicName, args, origin, allTools, events, ui, approvedForSession, signal } = options;
+	const digest = createHash("sha256").update(stableStringify(args)).digest("hex");
+	const cacheKey = `${server.name}\0${toolName}\0${digest}`;
+	if (approvedForSession.has(cacheKey)) return { allowed: true };
+
+	const decision = await brokerDecision(events, server, toolName, publicName, args, origin, signal);
+	if (decision === "allow_once") return { allowed: true };
+	if (decision === "allow_for_session") {
+		approvedForSession.set(cacheKey, true);
+		return { allowed: true };
+	}
+	if (decision === "deny") return { allowed: false, reason: "denied" };
+	if (!approvalRequired(server, toolName, allTools)) return { allowed: true };
+	if (!ui) return { allowed: false, reason: "approval-required-headless" };
+
+	const json = sanitizePromptText(JSON.stringify(args, null, 2));
+	const preview = json.length > 500 ? `${json.slice(0, 500)}…` : json;
+	const title = `MCP: ${sanitizePromptText(server.name)} wants to run ${sanitizePromptText(toolName)}`;
+	const selection = await awaitApproval(
+		ui.select(`${title}\n\nArguments:\n${preview}`, ["Allow once", "Allow for session", "Deny"], { signal }),
+		signal,
+	);
+	if (selection === "Allow once") return { allowed: true };
+	if (selection === "Allow for session") {
+		approvedForSession.set(cacheKey, true);
+		return { allowed: true };
+	}
+	return { allowed: false, reason: "denied" };
+}
diff --git a/packages/coding-agent/src/extensions/mcp/apps.ts b/packages/coding-agent/src/extensions/mcp/apps.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cca55f8a7c40fd548269408c15a2bc316446eb1c
--- /dev/null
+++ b/packages/coding-agent/src/extensions/mcp/apps.ts
@@ -0,0 +1,108 @@
+import type { Resource, Tool } from "@earendil-works/pi-mcp";
+import type { McpManagementAppResourceMetadata } from "../../core/mcp-management.ts";
+
+export type McpUiToolVisibility = "model" | "app";
+
+const CSP_FIELDS = ["resourceDomains", "connectDomains", "frameDomains", "baseUriDomains"] as const;
+const OPENAI_CSP_FIELDS = [
+	["resource_domains", "resourceDomains"],
+	["connect_domains", "connectDomains"],
+	["frame_domains", "frameDomains"],
+] as const;
+const UI_PERMISSIONS = ["camera", "microphone", "geolocation", "clipboardWrite"] as const;
+const MAX_CSP_DOMAINS = 128;
+const MAX_METADATA_STRING_LENGTH = 2_048;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Returns only app resource URIs from the two supported MCP Apps metadata shapes. */
+export function getMcpAppResourceUri(tool: Tool): string | undefined {
+	const meta = tool._meta;
+	if (!meta || !isRecord(meta)) return undefined;
+	const ui = meta.ui;
+	const uri = isRecord(ui) ? (ui.resourceUri ?? meta["ui/resourceUri"]) : meta["ui/resourceUri"];
+	return typeof uri === "string" && uri.length <= MAX_METADATA_STRING_LENGTH && uri.startsWith("ui://")
+		&& !/[\u0000-\u001f\u007f]/.test(uri)
+		? uri
+		: undefined;
+}
+
+/** Malformed visibility metadata denies both audiences rather than widening access. */
+export function getMcpUiToolVisibility(tool: Tool): readonly McpUiToolVisibility[] | undefined {
+	const meta = tool._meta;
+	if (!meta || !isRecord(meta) || !isRecord(meta.ui) || meta.ui.visibility === undefined) return undefined;
+	if (!Array.isArray(meta.ui.visibility)) return [];
+	const visibility: McpUiToolVisibility[] = [];
+	for (const value of meta.ui.visibility) {
+		if (value !== "model" && value !== "app") return [];
+		if (!visibility.includes(value)) visibility.push(value);
+	}
+	return visibility;
+}
+
+export function isMcpUiToolVisibleToModel(tool: Tool): boolean {
+	const visibility = getMcpUiToolVisibility(tool);
+	return visibility === undefined || visibility.includes("model");
+}
+
+export function isMcpUiToolCallableByApp(tool: Tool): boolean {
+	const visibility = getMcpUiToolVisibility(tool);
+	return visibility === undefined || visibility.includes("app");
+}
+
+export function isMcpAppResource(resource: Pick<Resource, "uri" | "mimeType">): boolean {
+	return resource.uri.startsWith("ui://") || /;\s*profile\s*=\s*"?mcp-app"?/i.test(resource.mimeType ?? "");
+}
+
+/** Copies only the CSP and iframe permissions understood by the existing adapter renderer. */
+export function getMcpAppResourceMetadata(meta: unknown): McpManagementAppResourceMetadata {
+	if (!isRecord(meta)) return {};
+	const ui = isRecord(meta.ui) ? meta.ui : undefined;
+	const canonicalCsp = ui?.csp;
+	const openAiCsp = meta["openai/widgetCSP"];
+	const csp: Record<string, readonly string[]> = {};
+	if (isRecord(openAiCsp)) {
+		for (const [source, target] of OPENAI_CSP_FIELDS) {
+			const domains = copyDomains(openAiCsp[source]);
+			if (domains) csp[target] = domains;
+		}
+	}
+	if (isRecord(canonicalCsp)) {
+		for (const field of CSP_FIELDS) {
+			const domains = copyDomains(canonicalCsp[field]);
+			if (domains) csp[field] = domains;
+			else if (Object.hasOwn(canonicalCsp, field)) delete csp[field];
+		}
+	}
+	const permissions: Record<string, boolean> = {};
+	if (isRecord(ui?.permissions)) {
+		for (const field of UI_PERMISSIONS) {
+			if (isRecord(ui.permissions[field])) permissions[field] = true;
+		}
+	}
+	const domain = typeof ui?.domain === "string" && validMetadataString(ui.domain) ? ui.domain : undefined;
+	const prefersBorder = typeof ui?.prefersBorder === "boolean" ? ui.prefersBorder : undefined;
+	return {
+		...(Object.keys(csp).length === 0 ? {} : { csp }),
+		...(Object.keys(permissions).length === 0 ? {} : { permissions }),
+		...(domain === undefined ? {} : { domain }),
+		...(prefersBorder === undefined ? {} : { prefersBorder }),
+	};
+}
+
+function copyDomains(value: unknown): readonly string[] | undefined {
+	if (
+		!Array.isArray(value) ||
+		value.length > MAX_CSP_DOMAINS ||
+		!value.every((entry) => typeof entry === "string" && validMetadataString(entry))
+	) {
+		return undefined;
+	}
+	return Object.freeze([...value]);
+}
+
+function validMetadataString(value: string): boolean {
+	return value.length <= MAX_METADATA_STRING_LENGTH && !/[\u0000-\u001f\u007f]/.test(value);
+}
diff --git a/packages/coding-agent/src/extensions/mcp/assembly.ts b/packages/coding-agent/src/extensions/mcp/assembly.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a8b701bf336c4f0dfc3756011da68d7a3828b982
--- /dev/null
+++ b/packages/coding-agent/src/extensions/mcp/assembly.ts
@@ -0,0 +1,196 @@
+/**
+ * Assembly seam for the built-in MCP owner.
+ *
+ * The built-in extension is created without options and remains the sole MCP owner. A consumer may
+ * install the config and credential boundaries it needs; the built-in factory resolves them at each
+ * session start. This does not configure separate instances returned by `createMcpExtension()`.
+ */
+
+import type { AuthStorageBackend } from "../../core/auth-storage.ts";
+import type { EventBus } from "../../core/event-bus.ts";
+import type { ExtensionContext } from "../../core/extensions/types.ts";
+import type { LoadedMcpConfig, McpServerConfigPatch, McpServerEntry } from "./config.ts";
+import type { McpOAuthCredentialBackend } from "./oauth.ts";
+
+/** Config and credentials supplied to the built-in MCP owner for each new session. */
+export interface McpOwnerAssembly {
+	/** Replaces the default reader of the agent directory and trusted project `mcp.json`. */
+	loadConfig?: (ctx: ExtensionContext) => LoadedMcpConfig;
+	/** Replaces the default writer for `/mcp` server configuration changes. */
+	updateConfig?: (entry: McpServerEntry, patch: McpServerConfigPatch) => void;
+	/**
+	 * Backend for selected migrated servers. Servers the OAuth backend does not handle keep the native
+	 * `mcp-auth.json` default; the adapter can share keyring entries without replacing stock storage.
+	 */
+	credentialsBackend?: AuthStorageBackend | McpOAuthCredentialBackend;
+}
+
+export type McpOwnerAssemblyErrorCode = "invalid-assembly" | "already-installed";
+
+export type McpOwnerAssemblyResult =
+	| { readonly ok: true; readonly value: () => void }
+	| {
+			readonly ok: false;
+			readonly error: { readonly code: McpOwnerAssemblyErrorCode; readonly message: string };
+	  };
+
+interface InstalledAssembly {
+	source: McpOwnerAssembly;
+	assembly: McpOwnerAssembly;
+	eventBus?: EventBus;
+	unsubscribeRequest?: () => void;
+	release: () => void;
+}
+
+const ASSEMBLY_REQUEST_EVENT = "pi:mcp-management:owner-assembly:request";
+const ASSEMBLY_INSTALL_EVENT = "pi:mcp-management:owner-assembly:install";
+const ASSEMBLY_RELEASE_EVENT = "pi:mcp-management:owner-assembly:release";
+
+let installed: InstalledAssembly | undefined;
+
+function connectAssemblyToOwner(registration: InstalledAssembly, eventBus: EventBus): boolean {
+	try {
+		if (registration.eventBus !== eventBus) {
+			registration.unsubscribeRequest?.();
+			registration.eventBus = eventBus;
+			registration.unsubscribeRequest = eventBus.on(ASSEMBLY_REQUEST_EVENT, () => {
+				eventBus.emit(ASSEMBLY_INSTALL_EVENT, registration.source);
+			});
+		}
+		eventBus.emit(ASSEMBLY_INSTALL_EVENT, registration.source);
+		return true;
+	} catch {
+		return false;
+	}
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function invalidAssembly(message: string): McpOwnerAssemblyResult {
+	return { ok: false, error: { code: "invalid-assembly", message } };
+}
+
+function parseAssembly(value: unknown): McpOwnerAssembly | McpOwnerAssemblyResult {
+	if (!isRecord(value)) return invalidAssembly("An MCP owner assembly must be an object.");
+
+	const loadConfig = value.loadConfig;
+	if (loadConfig !== undefined && typeof loadConfig !== "function") {
+		return invalidAssembly('The MCP owner assembly field "loadConfig" must be a function.');
+	}
+	const updateConfig = value.updateConfig;
+	if (updateConfig !== undefined && typeof updateConfig !== "function") {
+		return invalidAssembly('The MCP owner assembly field "updateConfig" must be a function.');
+	}
+
+	const credentialsBackend = value.credentialsBackend;
+	if (credentialsBackend !== undefined) {
+		if (!isRecord(credentialsBackend)) {
+			return invalidAssembly('The MCP owner assembly field "credentialsBackend" must be an object.');
+		}
+		if ("handlesServer" in credentialsBackend) {
+			for (const method of ["handlesServer", "forServer", "tokens", "remove"] as const) {
+				if (typeof credentialsBackend[method] !== "function") {
+					return invalidAssembly(`The MCP owner OAuth credential backend must provide ${method}().`);
+				}
+			}
+		} else {
+			for (const method of ["withLock", "withLockAsync"] as const) {
+				if (typeof credentialsBackend[method] !== "function") {
+					return invalidAssembly(`The MCP owner auth storage backend must provide ${method}().`);
+				}
+			}
+		}
+	}
+
+	if (loadConfig === undefined && updateConfig === undefined && credentialsBackend === undefined) {
+		return invalidAssembly("An MCP owner assembly must provide config access or credentials.");
+	}
+
+	return Object.freeze({
+		...(loadConfig === undefined ? {} : { loadConfig: loadConfig as McpOwnerAssembly["loadConfig"] }),
+		...(updateConfig === undefined ? {} : { updateConfig: updateConfig as McpOwnerAssembly["updateConfig"] }),
+		...(credentialsBackend === undefined
+			? {}
+			: { credentialsBackend: credentialsBackend as unknown as AuthStorageBackend | McpOAuthCredentialBackend }),
+	});
+}
+
+/**
+ * Installs config and/or credentials for the built-in MCP owner. Installing a different assembly
+ * while one is active fails instead of silently replacing the session's owner. Reinstalling the
+ * same object is idempotent. The returned disposer affects future sessions; an active session keeps
+ * the assembly it resolved until that session shuts down.
+ */
+export function installMcpOwnerAssembly(assembly: McpOwnerAssembly, eventBus?: EventBus): McpOwnerAssemblyResult {
+	let parsed: McpOwnerAssembly | McpOwnerAssemblyResult;
+	try {
+		parsed = parseAssembly(assembly);
+	} catch {
+		return invalidAssembly("The MCP owner assembly fields could not be read.");
+	}
+	if ("ok" in parsed) return parsed;
+
+	if (installed) {
+		if (installed.source === assembly) {
+			if (eventBus && !connectAssemblyToOwner(installed, eventBus)) {
+				return invalidAssembly("Pi's MCP owner event bus could not receive the installed assembly.");
+			}
+			return { ok: true, value: installed.release };
+		}
+		return {
+			ok: false,
+			error: {
+				code: "already-installed",
+				message: "A different MCP owner assembly is already installed; remove it before installing a replacement.",
+			},
+		};
+	}
+
+	let registration: InstalledAssembly;
+	const release = () => {
+		if (installed === registration) installed = undefined;
+		const currentEventBus = registration.eventBus;
+		registration.unsubscribeRequest?.();
+		registration.unsubscribeRequest = undefined;
+		registration.eventBus = undefined;
+		currentEventBus?.emit(ASSEMBLY_RELEASE_EVENT, registration.source);
+	};
+	registration = { source: assembly, assembly: parsed, release };
+	installed = registration;
+	if (eventBus && !connectAssemblyToOwner(registration, eventBus)) {
+		release();
+		return invalidAssembly("Pi's MCP owner event bus could not receive the installed assembly.");
+	}
+	return { ok: true, value: release };
+}
+
+/** Assembly resolved by the built-in MCP factory; separate `createMcpExtension()` instances do not use it. */
+export function getMcpOwnerAssembly(): McpOwnerAssembly | undefined {
+	return installed?.assembly;
+}
+
+/** Bridges an adapter-installed assembly into this built-in owner's module instance. */
+export function listenForMcpOwnerAssembly(eventBus: EventBus): () => void {
+	let activeSource: McpOwnerAssembly | undefined;
+	let releaseActive: (() => void) | undefined;
+	const unsubscribeInstall = eventBus.on(ASSEMBLY_INSTALL_EVENT, (value) => {
+		const result = installMcpOwnerAssembly(value as McpOwnerAssembly);
+		if (!result.ok) return;
+		activeSource = value as McpOwnerAssembly;
+		releaseActive = result.value;
+	});
+	const unsubscribeRelease = eventBus.on(ASSEMBLY_RELEASE_EVENT, (value) => {
+		if (value !== activeSource) return;
+		releaseActive?.();
+		releaseActive = undefined;
+		activeSource = undefined;
+	});
+	eventBus.emit(ASSEMBLY_REQUEST_EVENT, undefined);
+	return () => {
+		unsubscribeInstall();
+		unsubscribeRelease();
+		releaseActive?.();
+	};
+}
diff --git a/packages/coding-agent/src/extensions/mcp/catalog-cache.ts b/packages/coding-agent/src/extensions/mcp/catalog-cache.ts
new file mode 100644
index 0000000000000000000000000000000000000000..145e12ac3dc5ec501e509c4378f2e881892f6a17
--- /dev/null
+++ b/packages/coding-agent/src/extensions/mcp/catalog-cache.ts
@@ -0,0 +1,227 @@
+import { createHash, randomUUID } from "node:crypto";
+import { existsSync, mkdirSync, readFileSync, renameSync, statSync, unlinkSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+import type { McpServerConfig } from "./config.ts";
+
+export const MCP_CATALOG_CACHE_VERSION = 1 as const;
+export const MCP_CATALOG_CACHE_MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000;
+
+const SERVER_NAME = /^[A-Za-z0-9_-]+$/;
+const CONFIG_HASH = /^[a-f0-9]{64}$/;
+const MAX_CATALOG_CACHE_BYTES = 8 * 1024 * 1024;
+const MAX_CACHED_SERVERS = 2_000;
+const MAX_CACHED_TOOLS_PER_SERVER = 10_000;
+const MAX_TOOL_NAME_LENGTH = 1_024;
+const MAX_TOOL_DESCRIPTION_LENGTH = 10_000;
+
+type McpCatalogCacheErrorCode = "invalid-cache" | "unsupported-cache-version" | "invalid-catalog";
+
+export type McpCatalogCacheResult<T> =
+	| { readonly ok: true; readonly value: T }
+	| { readonly ok: false; readonly error: { readonly code: McpCatalogCacheErrorCode; readonly message: string } };
+
+export interface McpCatalogSeedTool {
+	readonly name: string;
+	readonly description?: string;
+}
+
+interface McpCatalogCacheEntry {
+	readonly configHash: string;
+	readonly cachedAt: number;
+	readonly expiresAt: number;
+	readonly tools: readonly McpCatalogSeedTool[];
+}
+
+interface McpCatalogCacheFile {
+	readonly version: typeof MCP_CATALOG_CACHE_VERSION;
+	readonly servers: Readonly<Record<string, McpCatalogCacheEntry>>;
+}
+
+function success<T>(value: T): McpCatalogCacheResult<T> {
+	return { ok: true, value };
+}
+
+function failure<T>(code: McpCatalogCacheErrorCode, message: string): McpCatalogCacheResult<T> {
+	return { ok: false, error: { code, message } };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function hasOnlyKeys(value: Record<string, unknown>, allowed: readonly string[]): boolean {
+	return Object.keys(value).every((key) => allowed.includes(key));
+}
+
+/** Validates persisted cache data before it can seed a session catalog. */
+export function parseMcpCatalogCache(value: unknown, now = Date.now()): McpCatalogCacheResult<McpCatalogCacheFile> {
+	if (!isRecord(value) || !hasOnlyKeys(value, ["version", "servers"])) {
+		return failure("invalid-cache", "The MCP catalog cache has an invalid structure.");
+	}
+	if (value.version !== MCP_CATALOG_CACHE_VERSION) {
+		return failure("unsupported-cache-version", "The MCP catalog cache version is unsupported.");
+	}
+	if (!isRecord(value.servers) || Object.keys(value.servers).length > MAX_CACHED_SERVERS) {
+		return failure("invalid-cache", "The MCP catalog cache has an invalid server list.");
+	}
+
+	const servers: Record<string, McpCatalogCacheEntry> = Object.create(null) as Record<string, McpCatalogCacheEntry>;
+	for (const [name, rawEntry] of Object.entries(value.servers)) {
+		if (
+			!SERVER_NAME.test(name) ||
+			!isRecord(rawEntry) ||
+			!hasOnlyKeys(rawEntry, ["configHash", "cachedAt", "expiresAt", "tools"])
+		) {
+			return failure("invalid-cache", "The MCP catalog cache contains an invalid server entry.");
+		}
+		const { configHash, cachedAt, expiresAt, tools: rawTools } = rawEntry;
+		if (
+			typeof configHash !== "string" ||
+			!CONFIG_HASH.test(configHash) ||
+			typeof cachedAt !== "number" ||
+			!Number.isSafeInteger(cachedAt) ||
+			cachedAt <= 0 ||
+			cachedAt > now ||
+			typeof expiresAt !== "number" ||
+			!Number.isSafeInteger(expiresAt) ||
+			expiresAt !== cachedAt + MCP_CATALOG_CACHE_MAX_AGE_MS ||
+			!Array.isArray(rawTools) ||
+			rawTools.length > MAX_CACHED_TOOLS_PER_SERVER
+		) {
+			return failure("invalid-cache", "The MCP catalog cache contains invalid validity metadata.");
+		}
+
+		const tools: McpCatalogSeedTool[] = [];
+		const names = new Set<string>();
+		for (const rawTool of rawTools) {
+			if (!isRecord(rawTool) || !hasOnlyKeys(rawTool, ["name", "description"])) {
+				return failure("invalid-cache", "The MCP catalog cache contains an invalid tool entry.");
+			}
+			const { name: toolName, description } = rawTool;
+			if (
+				typeof toolName !== "string" ||
+				toolName.length === 0 ||
+				toolName.length > MAX_TOOL_NAME_LENGTH ||
+				(description !== undefined &&
+					(typeof description !== "string" || description.length > MAX_TOOL_DESCRIPTION_LENGTH)) ||
+				names.has(toolName)
+			) {
+				return failure("invalid-cache", "The MCP catalog cache contains invalid tool metadata.");
+			}
+			names.add(toolName);
+			tools.push(Object.freeze({ name: toolName, ...(description === undefined ? {} : { description }) }));
+		}
+		servers[name] = Object.freeze({ configHash, cachedAt, expiresAt, tools: Object.freeze(tools) });
+	}
+
+	return success(Object.freeze({ version: MCP_CATALOG_CACHE_VERSION, servers: Object.freeze(servers) }));
+}
+
+/** Hashes server identity and catalog-affecting settings without persisting raw configuration. */
+export function computeMcpCatalogConfigHash(config: McpServerConfig, cwd: string): string {
+	const {
+		enabled: _enabled,
+		exposure: _exposure,
+		toolExposure: _toolExposure,
+		lifecycle: _lifecycle,
+		idleTimeout: _idleTimeout,
+		timeout: _timeout,
+		...identity
+	} = config;
+	const normalized = stableStringify({ cwd, config: identity });
+	return createHash("sha256").update(normalized).digest("hex");
+}
+
+function stableStringify(value: unknown): string {
+	if (value === null || typeof value !== "object") return JSON.stringify(value) ?? "undefined";
+	if (Array.isArray(value)) return `[${value.map(stableStringify).join(",")}]`;
+	const record = value as Record<string, unknown>;
+	return `{${Object.keys(record)
+		.sort()
+		.map((key) => `${JSON.stringify(key)}:${stableStringify(record[key])}`)
+		.join(",")}}`;
+}
+
+/** A small data-only store for offline management snapshots; it never contains executable data. */
+export class McpCatalogSeedStore {
+	private entries: Record<string, McpCatalogCacheEntry> = Object.create(null) as Record<string, McpCatalogCacheEntry>;
+	private readonly path: string;
+
+	constructor(path: string) {
+		this.path = path;
+		this.entries = this.readEntries();
+	}
+
+	get(serverName: string, configHash: string, now = Date.now()): readonly McpCatalogSeedTool[] | undefined {
+		const entry = this.entries[serverName];
+		if (!entry || entry.configHash !== configHash || entry.expiresAt <= now) return undefined;
+		return entry.tools.map((tool) => ({ ...tool }));
+	}
+
+	save(
+		serverName: string,
+		configHash: string,
+		tools: readonly McpCatalogSeedTool[],
+		cachedAt = Date.now(),
+	): McpCatalogCacheResult<void> {
+		const retainedEntries = Object.fromEntries(
+			Object.entries(this.readEntries()).filter(([, entry]) => entry.expiresAt > cachedAt),
+		);
+		const candidate = {
+			version: MCP_CATALOG_CACHE_VERSION,
+			servers: {
+				...retainedEntries,
+				[serverName]: {
+					configHash,
+					cachedAt,
+					expiresAt: cachedAt + MCP_CATALOG_CACHE_MAX_AGE_MS,
+					tools: tools.map((tool) => ({
+						name: tool.name,
+						...(tool.description === undefined ? {} : { description: tool.description }),
+					})),
+				},
+			},
+		};
+		const validated = parseMcpCatalogCache(candidate, cachedAt);
+		if (!validated.ok)
+			return failure("invalid-catalog", "The live MCP catalog could not be saved as an offline seed.");
+		const serialized = JSON.stringify(validated.value);
+		if (Buffer.byteLength(serialized, "utf8") > MAX_CATALOG_CACHE_BYTES) {
+			return failure("invalid-catalog", "The live MCP catalog is too large to save as an offline seed.");
+		}
+		let temporaryPath: string | undefined;
+		try {
+			mkdirSync(dirname(this.path), { recursive: true });
+			temporaryPath = `${this.path}.${process.pid}.${randomUUID()}.tmp`;
+			writeFileSync(temporaryPath, serialized, { encoding: "utf8", mode: 0o600 });
+			renameSync(temporaryPath, this.path);
+			this.entries = { ...validated.value.servers };
+			return success(undefined);
+		} catch {
+			if (temporaryPath) {
+				try {
+					unlinkSync(temporaryPath);
+				} catch {
+					// Preserve the original write error if best-effort cleanup also fails.
+				}
+			}
+			return failure("invalid-catalog", "The MCP catalog cache could not be written.");
+		}
+	}
+
+	private readEntries(): Record<string, McpCatalogCacheEntry> {
+		if (!existsSync(this.path)) return Object.create(null) as Record<string, McpCatalogCacheEntry>;
+		try {
+			if (statSync(this.path).size > MAX_CATALOG_CACHE_BYTES) {
+				return Object.create(null) as Record<string, McpCatalogCacheEntry>;
+			}
+			const parsed: unknown = JSON.parse(readFileSync(this.path, "utf8"));
+			const validated = parseMcpCatalogCache(parsed);
+			return validated.ok
+				? { ...validated.value.servers }
+				: (Object.create(null) as Record<string, McpCatalogCacheEntry>);
+		} catch {
+			return Object.create(null) as Record<string, McpCatalogCacheEntry>;
+		}
+	}
+}
