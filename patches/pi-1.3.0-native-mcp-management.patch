@@ -0,0 +1,138 @@
+import type { Api, AssistantMessage, Model } from "@earendil-works/pi-ai";
+import { complete } from "@earendil-works/pi-ai/compat";
+import type { McpClient } from "@earendil-works/pi-mcp";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { registerMcpSamplingHandler } from "../src/extensions/mcp/sampling.ts";
+
+vi.mock("@earendil-works/pi-ai/compat", () => ({ complete: vi.fn() }));
+
+const model = {
+	id: "fixture-model",
+	provider: "fixture-provider",
+	name: "Fixture Model",
+	api: "openai-completions",
+	contextWindow: 4096,
+	maxTokens: 1024,
+} as unknown as Model<Api>;
+
+function fixture(options: Partial<Parameters<typeof registerMcpSamplingHandler>[1]> = {}) {
+	let handler: ((value: unknown, context: { signal: AbortSignal }) => Promise<unknown>) | undefined;
+	const client = {
+		setRequestHandler(_method: string, requestHandler: unknown) {
+			handler = requestHandler as typeof handler;
+		},
+	} as unknown as McpClient;
+	const confirm = vi.fn(async () => true);
+	registerMcpSamplingHandler(client, {
+		serverName: "docs",
+		autoApprove: false,
+		ui: { confirm },
+		modelRegistry: {
+			getAvailable: () => [model],
+			getApiKeyAndHeaders: async () => ({ ok: true, apiKey: "fixture-key" }),
+		} as unknown as Parameters<typeof registerMcpSamplingHandler>[1]["modelRegistry"],
+		getCurrentModel: () => model,
+		...options,
+	});
+	if (!handler) throw new Error("Sampling request handler was not registered");
+	return { handler, confirm };
+}
+
+function assistantResponse(text: string): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "text", text }],
+		api: model.api,
+		provider: model.provider,
+		model: model.id,
+		usage: {
+			input: 0,
+			output: 1,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 1,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "stop",
+		timestamp: 1,
+	};
+}
+
+const params = { messages: [{ role: "user", content: "hello" }], maxTokens: 32 };
+
+beforeEach(() => vi.mocked(complete).mockReset());
+
+describe("native MCP sampling", () => {
+	it("validates requests and rejects unsupported context or tool execution", async () => {
+		const { handler } = fixture({ autoApprove: true });
+		const signal = new AbortController().signal;
+
+		await expect(handler({ messages: [], maxTokens: 1 }, { signal })).rejects.toThrow("between 1 and 128 messages");
+		await expect(handler({ ...params, includeContext: "thisServer" }, { signal })).rejects.toThrow(
+			"context inclusion is not supported",
+		);
+		await expect(handler({ ...params, tools: [{ name: "write_file" }] }, { signal })).rejects.toThrow(
+			"tool use is not supported",
+		);
+		await expect(
+			handler({ ...params, messages: [{ role: "user", content: [{ type: "image", data: "x" }] }] }, { signal }),
+		).rejects.toThrow("Only text content");
+		await expect(handler({ ...params, maxTokens: 2048 }, { signal })).rejects.toThrow("selected model maximum");
+		expect(complete).not.toHaveBeenCalled();
+	});
+
+	it("requires interactive approval unless auto-approve was explicitly enabled", async () => {
+		const headless = fixture({ ui: undefined });
+		await expect(headless.handler(params, { signal: new AbortController().signal })).rejects.toThrow(
+			"not allowed in a headless session",
+		);
+		expect(complete).not.toHaveBeenCalled();
+
+		vi.mocked(complete).mockResolvedValue(assistantResponse("answer"));
+		const automatic = fixture({ autoApprove: true, ui: undefined });
+		await expect(automatic.handler(params, { signal: new AbortController().signal })).resolves.toMatchObject({
+			role: "assistant",
+			content: { type: "text", text: "answer" },
+		});
+	});
+
+	it("uses only an allowed Pi model and confirms both request and returned response", async () => {
+		vi.mocked(complete).mockResolvedValue(assistantResponse("sampled response"));
+		const { handler, confirm } = fixture();
+		const response = await handler(
+			{
+				...params,
+				systemPrompt: "answer briefly",
+				modelPreferences: { hints: [{ name: "fixture-model" }] },
+			},
+			{ signal: new AbortController().signal },
+		);
+
+		expect(confirm).toHaveBeenCalledTimes(2);
+		expect(response).toMatchObject({
+			role: "assistant",
+			content: { type: "text", text: "sampled response" },
+			model: "fixture-provider/fixture-model",
+			stopReason: "endTurn",
+		});
+		expect(complete).toHaveBeenCalledWith(
+			model,
+			expect.objectContaining({ systemPrompt: "answer briefly" }),
+			expect.objectContaining({ maxTokens: 32, signal: expect.any(AbortSignal) }),
+		);
+
+		const forbidden = fixture({ isModelAllowed: () => false, autoApprove: true });
+		await expect(forbidden.handler(params, { signal: new AbortController().signal })).rejects.toThrow(
+			"No Pi model is available",
+		);
+	});
+
+	it("does not return tool-use or non-text sampling results", async () => {
+		vi.mocked(complete).mockResolvedValue({
+			...assistantResponse(""),
+			stopReason: "toolUse",
+		} as AssistantMessage);
+		const { handler } = fixture({ autoApprove: true });
+		await expect(handler(params, { signal: new AbortController().signal })).rejects.toThrow("tool calls");
+	});
+});
diff --git a/packages/coding-agent/test/mcp-tool-policy.test.ts b/packages/coding-agent/test/mcp-tool-policy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dc9f929277bdb245a5514e5230d9ce0fd2ae5aca
--- /dev/null
+++ b/packages/coding-agent/test/mcp-tool-policy.test.ts
@@ -0,0 +1,99 @@
+import { describe, expect, it, vi } from "vitest";
+import type { McpManagementExecutionPolicy } from "../src/core/mcp-management.ts";
+import { convertMcpResult, createMcpToolDefinition, validateMcpToolArguments } from "../src/extensions/mcp/tools.ts";
+
+describe("native MCP tool safety policies", () => {
+	it("recovers JSON-encoded nested objects and validates the complete argument schema", () => {
+		const schema = {
+			type: "object",
+			properties: {
+				filter: {
+					type: "object",
+					properties: { kind: { type: "string" } },
+					required: ["kind"],
+					additionalProperties: false,
+				},
+			},
+			required: ["filter"],
+			additionalProperties: false,
+		};
+
+		expect(validateMcpToolArguments(schema, { filter: '{"kind":"file"}' })).toEqual({
+			ok: true,
+			args: { filter: { kind: "file" } },
+		});
+		expect(validateMcpToolArguments(schema, { filter: "{broken" })).toMatchObject({
+			ok: false,
+			code: "invalid-arguments",
+		});
+		expect(validateMcpToolArguments(schema, { filter: { kind: "file", unexpected: true } })).toMatchObject({
+			ok: false,
+			code: "invalid-arguments",
+		});
+		expect(validateMcpToolArguments(schema, [])).toMatchObject({
+			ok: false,
+			code: "invalid-arguments",
+		});
+	});
+
+	it("rejects invalid direct arguments before connecting to or invoking a server", async () => {
+		const getClient = vi.fn();
+		const definition = createMcpToolDefinition({
+			server: "docs",
+			tool: {
+				name: "count",
+				inputSchema: {
+					type: "object",
+					properties: { count: { type: "integer" } },
+					required: ["count"],
+					additionalProperties: false,
+				},
+			},
+			name: "docs_count",
+			exposure: "direct",
+			namespace: { name: "docs", aliases: ["docs"] },
+			timeoutMs: 1000,
+			getClient,
+			executionPolicy: { strictDirectToolArguments: true },
+		});
+
+		await expect(definition.execute("invalid", { count: "3" }, new AbortController().signal)).rejects.toThrow(
+			"do not match the advertised schema",
+		);
+		expect(getClient).not.toHaveBeenCalled();
+	});
+
+	it("bounds model-facing text and structured results without claiming the full payload was returned", async () => {
+		let saveCount = 0;
+		const saved: Array<string | Uint8Array> = [];
+		const result = await convertMcpResult(
+			"docs",
+			"report",
+			{
+				content: [{ type: "text", text: "one\ntwo\nthree\nfour\nfive" }],
+				structuredContent: { payload: "x".repeat(500) },
+			},
+			{
+				executionPolicy: {
+					outputGuard: { maxBytes: 28, maxLines: 2, detailsMaxBytes: 32 },
+				} satisfies McpManagementExecutionPolicy,
+				saveOutput: async (data) => {
+					saved.push(data);
+					return `fixture-output-${++saveCount}`;
+				},
+			},
+		);
+
+		expect(result.content[0]?.type).toBe("text");
+		if (result.content[0]?.type !== "text") throw new Error("Expected bounded text content");
+		expect(result.content[0].text).toContain("Warning: truncated output");
+		expect(result.content[0].text).toContain("middle lines omitted");
+		expect(result.details?.fullOutputPath).toBe("fixture-output-1");
+		expect(result.structuredContent).toMatchObject({
+			omitted: true,
+			reason: "MCP result exceeded the configured details limit.",
+			fullResultPath: "fixture-output-2",
+		});
+		expect(saved).toHaveLength(2);
+	});
+});
