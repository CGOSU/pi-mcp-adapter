+const SERVER_NAME_PATTERN = /^[A-Za-z0-9_-]+$/;
+const REQUEST_ID_PATTERN = /^[A-Za-z0-9._:-]{1,128}$/;
+const CAPABILITY_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
+const TOOL_CONTROL_CHARACTERS = /[\u0000-\u001f\u007f]/;
+const MAX_REQUIRED_CAPABILITIES = 64;
+const MCP_EXPOSURES: readonly McpExposure[] = ["codemode", "deferred", "direct", "hidden"];
+const SESSION_ENDED = "This MCP management handle belongs to an ended session.";
+const MAX_APP_TOOL_ARGUMENT_BYTES = 1_000_000;
+const MAX_APP_TOOL_ARGUMENT_DEPTH = 64;
+
+export function mcpManagementOk<T>(value: T): McpManagementResult<T> {
+	return { ok: true, value };
+}
+
+export function mcpManagementError(
+	code: McpManagementErrorCode,
+	message: string,
