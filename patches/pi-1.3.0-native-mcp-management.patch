+
+export const MCP_MANAGEMENT_CAPABILITIES = Object.freeze([
+	"server.snapshot",
+	"server.subscribe",
+	"server.enable",
+	"server.disable",
+	"server.reconnect",
+	"server.set-exposure",
+	"tool.set-exposure",
