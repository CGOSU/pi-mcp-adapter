diff --git a/packages/coding-agent/test/mcp-catalog-cache.test.ts b/packages/coding-agent/test/mcp-catalog-cache.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..93453199001aca1b07ed9782ee58519c158e5d8e
--- /dev/null
+++ b/packages/coding-agent/test/mcp-catalog-cache.test.ts
@@ -0,0 +1,101 @@
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import {
+	computeMcpCatalogConfigHash,
+	MCP_CATALOG_CACHE_MAX_AGE_MS,
+	MCP_CATALOG_CACHE_VERSION,
+	McpCatalogSeedStore,
+	parseMcpCatalogCache,
+} from "../src/extensions/mcp/catalog-cache.ts";
+import type { McpServerConfig } from "../src/extensions/mcp/config.ts";
+
+const HASH = "a".repeat(64);
+
+describe("native MCP catalog cache", () => {
+	const directories: string[] = [];
+	afterEach(() => {
+		for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true });
+	});
+
+	it("validates persisted structure before exposing a seed", () => {
+		const valid = parseMcpCatalogCache(
+			{
+				version: MCP_CATALOG_CACHE_VERSION,
+				servers: {
+					docs: {
+						configHash: HASH,
+						cachedAt: 1_000,
+						expiresAt: 1_000 + MCP_CATALOG_CACHE_MAX_AGE_MS,
+						tools: [{ name: "search", description: "Search docs" }],
+					},
+				},
+			},
+			1_001,
+		);
+		expect(valid).toMatchObject({
+			ok: true,
+			value: { servers: { docs: { tools: [{ name: "search" }] } } },
+		});
+
+		const invalid = parseMcpCatalogCache({
+			version: MCP_CATALOG_CACHE_VERSION,
+			servers: { docs: { configHash: HASH, cachedAt: 1_000, expiresAt: 1_001, tools: [] } },
+		});
+		expect(invalid).toMatchObject({ ok: false, error: { code: "invalid-cache" } });
+
+		const unexpected = parseMcpCatalogCache({
+			version: MCP_CATALOG_CACHE_VERSION,
+			credentials: "must not be accepted",
+			servers: {},
+		});
+		expect(unexpected).toMatchObject({ ok: false, error: { code: "invalid-cache" } });
+	});
+
+	it("seeds only matching, unexpired catalogs and persists data-only fields", () => {
+		const directory = mkdtempSync(join(tmpdir(), "pi-mcp-catalog-cache-"));
+		directories.push(directory);
+		const path = join(directory, "mcp-catalog-cache.json");
+		const store = new McpCatalogSeedStore(path);
+		const now = Date.now();
+		expect(store.save("docs", HASH, [{ name: "search", description: "Search docs" }], now).ok).toBe(true);
+
+		const raw = readFileSync(path, "utf8");
+		expect(raw).not.toContain("client");
+		expect(raw).not.toContain("secret");
+		expect(JSON.parse(raw)).toEqual({
+			version: MCP_CATALOG_CACHE_VERSION,
+			servers: {
+				docs: {
+					configHash: HASH,
+					cachedAt: now,
+					expiresAt: now + MCP_CATALOG_CACHE_MAX_AGE_MS,
+					tools: [{ name: "search", description: "Search docs" }],
+				},
+			},
+		});
+
+		const reloaded = new McpCatalogSeedStore(path);
+		expect(reloaded.get("docs", HASH, now + MCP_CATALOG_CACHE_MAX_AGE_MS - 1)).toEqual([
+			{ name: "search", description: "Search docs" },
+		]);
+		expect(reloaded.get("docs", HASH, now + MCP_CATALOG_CACHE_MAX_AGE_MS)).toBeUndefined();
+		expect(reloaded.get("docs", "b".repeat(64), now)).toBeUndefined();
+	});
+
+	it("does not invalidate a catalog for lifecycle-only changes", () => {
+		const base: McpServerConfig = {
+			command: "mcp-server",
+			args: ["--mode", "read"],
+			// biome-ignore lint/suspicious/noTemplateCurlyInString: config placeholders must remain literal.
+			env: { API_KEY: "${API_KEY}" },
+		};
+		const lazy: McpServerConfig = { ...base, lifecycle: "lazy", idleTimeout: 10 };
+		const eager: McpServerConfig = { ...base, lifecycle: "eager", idleTimeout: 0, timeout: 5 };
+		expect(computeMcpCatalogConfigHash(lazy, "/project")).toBe(computeMcpCatalogConfigHash(eager, "/project"));
+		expect(computeMcpCatalogConfigHash(base, "/project")).not.toBe(
+			computeMcpCatalogConfigHash({ ...base, command: "replacement" }, "/project"),
+		);
+	});
+});
diff --git a/packages/coding-agent/test/mcp-direct-tools-config.test.ts b/packages/coding-agent/test/mcp-direct-tools-config.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b83514d111e1c4389c76d15ea413db750cd2eb8e
--- /dev/null
+++ b/packages/coding-agent/test/mcp-direct-tools-config.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { validateMcpServerConfig } from "../src/core/mcp-servers.ts";
+
+describe("MCP directTools server configuration", () => {
+  it("accepts explicit booleans and bounded tool selections", () => {
+    expect(validateMcpServerConfig("docs", { command: "docs-server", directTools: false })).toMatchObject({
+      command: "docs-server",
+      directTools: false,
+    });
+    expect(validateMcpServerConfig("docs", { command: "docs-server", directTools: ["search", "read_file"] })).toMatchObject({
+      command: "docs-server",
+      directTools: ["search", "read_file"],
+    });
+    expect(validateMcpServerConfig("docs", { command: "docs-server", directTools: [] })).toMatchObject({
+      command: "docs-server",
+      directTools: [],
+    });
+  });
+
+  it("rejects empty, oversized, control-character, and sparse tool selections", () => {
+    const invalidSelections: unknown[] = [
+      [""],
+      ["x".repeat(257)],
+      Array.from({ length: 257 }, (_, index) => `tool-${index}`),
+      [`bad${String.fromCharCode(0x7f)}name`],
+      new Array<string>(1),
+    ];
+
+    for (const directTools of invalidSelections) {
+      expect(validateMcpServerConfig("docs", { command: "docs-server", directTools })).toContain(
+        "directTools must be a boolean or an array of at most 256 bounded tool names",
+      );
+    }
+  });
+});
diff --git a/packages/coding-agent/test/mcp-elicitation.test.ts b/packages/coding-agent/test/mcp-elicitation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..17ba4bd66a42772b838686cbf76213689f0871c0
--- /dev/null
+++ b/packages/coding-agent/test/mcp-elicitation.test.ts
@@ -0,0 +1,178 @@
+import type { McpClient } from "@earendil-works/pi-mcp";
+import { describe, expect, it, vi } from "vitest";
+import { type McpElicitationHandlerOptions, registerMcpElicitationHandler } from "../src/extensions/mcp/elicitation.ts";
+
+function fixture(
+	choices: Array<string | undefined>,
+	inputs: Array<string | undefined> = [],
+	overrides: Partial<McpElicitationHandlerOptions> = {},
+) {
+	let handler: ((value: unknown, context: { signal: AbortSignal }) => Promise<unknown>) | undefined;
+	const client = {
+		setRequestHandler(_method: string, requestHandler: unknown) {
+			handler = requestHandler as typeof handler;
+		},
+	} as unknown as McpClient;
+	const ui = {
+		select: vi.fn(async () => choices.shift()),
+		input: vi.fn(async () => inputs.shift()),
+		notify: vi.fn(),
+	};
+	const openUrl = vi.fn();
+	registerMcpElicitationHandler(client, {
+		serverName: "docs",
+		ui,
+		allowUrl: false,
+		openUrl,
+		...overrides,
+	});
+	if (!handler) throw new Error("Elicitation request handler was not registered");
+	return { handler, ui, openUrl };
+}
+
+const request = (requestedSchema: unknown, message = "Complete this request") => ({
+	mode: "form",
+	message,
+	requestedSchema,
+});
+
+describe("native MCP elicitation", () => {
+	it("validates and reviews submitted form values, including literal values named cancelled", async () => {
+		const { handler, ui } = fixture(["Continue", "cancelled", "Submit"]);
+		const result = await handler(
+			request({
+				type: "object",
+				properties: { choice: { type: "string", enum: ["cancelled"] } },
+				required: ["choice"],
+			}),
+			{ signal: new AbortController().signal },
+		);
+
+		expect(result).toEqual({ action: "accept", content: { choice: "cancelled" } });
+		expect(ui.select).toHaveBeenCalledTimes(3);
+	});
+
+	it("re-prompts for values that violate supported formats and bounds", async () => {
+		const { handler, ui } = fixture(
+			["Continue", "Enter value", "Enter value", "Submit"],
+			["not-an-email", "user@example.com"],
+		);
+		const result = await handler(
+			request({
+				type: "object",
+				properties: {
+					email: { type: "string", format: "email", maxLength: 64 },
+				},
+				required: ["email"],
+			}),
+			{ signal: new AbortController().signal },
+		);
+
+		expect(result).toEqual({ action: "accept", content: { email: "user@example.com" } });
+		expect(ui.notify).toHaveBeenCalledWith(expect.stringContaining("does not match email format"), "error");
+	});
+
+	it("rejects unsupported schema constraints instead of silently accepting invalid input", async () => {
+		const { handler, ui } = fixture([]);
+		await expect(
+			handler(
+				request({
+					type: "object",
+					properties: { value: { type: "string", pattern: "^[a-z]+$" } },
+				}),
+				{ signal: new AbortController().signal },
+			),
+		).rejects.toThrow("unsupported constraint");
+		expect(ui.select).not.toHaveBeenCalled();
+	});
+
+	it("sanitizes untrusted UI text and fails closed without an interactive UI", async () => {
+		const { handler, ui } = fixture(["Continue", "Enter value", "Submit"], ["safe"]);
+		const result = await handler(
+			request(
+				{
+					type: "object",
+					properties: { value: { type: "string" } },
+				},
+				"\u001b[31mremote request\u001b[0m",
+			),
+			{ signal: new AbortController().signal },
+		);
+		expect(result).toEqual({ action: "accept", content: { value: "safe" } });
+		expect(ui.select.mock.calls[0]?.[0]).not.toContain("\u001b");
+
+		const headless = fixture([], [], { ui: undefined });
+		await expect(
+			headless.handler(request({ type: "object", properties: {} }), {
+				signal: new AbortController().signal,
+			}),
+		).rejects.toThrow("no response was accepted");
+	});
+
+	it("opens only explicitly approved HTTP(S) URLs without embedded credentials", async () => {
+		const openUrl = vi.fn();
+		const onUrlAccepted = vi.fn();
+		const approved = fixture(["Open"], [], { allowUrl: true, openUrl, onUrlAccepted });
+		const result = await approved.handler(
+			{
+				mode: "url",
+				url: "https://example.com/authorize?state=fixture",
+				message: "Continue in browser",
+				elicitationId: "elicitation-1",
+			},
+			{ signal: new AbortController().signal },
+		);
+
+		expect(result).toEqual({ action: "accept" });
+		expect(openUrl).toHaveBeenCalledWith("https://example.com/authorize?state=fixture");
+		expect(onUrlAccepted).toHaveBeenCalledWith("elicitation-1");
+
+		const credentials = fixture([], [], { allowUrl: true });
+		await expect(
+			credentials.handler(
+				{
+					mode: "url",
+					url: "https://user:secret@example.com/authorize",
+					message: "Continue",
+					elicitationId: "elicitation-2",
+				},
+				{ signal: new AbortController().signal },
+			),
+		).rejects.toThrow("embedded credentials");
+		expect(credentials.ui.select).not.toHaveBeenCalled();
+	});
+
+	it("returns cancel when the browser launcher fails and propagates UI cancellation", async () => {
+		const onUrlAccepted = vi.fn();
+		const launcherFailure = fixture(["Open"], [], {
+			allowUrl: true,
+			openUrl: () => {
+				throw new Error("private launcher error");
+			},
+			onUrlAccepted,
+		});
+		const params = {
+			mode: "url",
+			url: "https://example.com/authorize",
+			message: "Continue",
+			elicitationId: "elicitation-3",
+		};
+		expect(await launcherFailure.handler(params, { signal: new AbortController().signal })).toEqual({
+			action: "cancel",
+		});
+		expect(launcherFailure.ui.notify).toHaveBeenCalledWith("Could not open the MCP elicitation URL.", "error");
+		expect(onUrlAccepted).not.toHaveBeenCalled();
+
+		const controller = new AbortController();
+		const pending = fixture([], [], {
+			ui: {
+				select: () => new Promise<string | undefined>(() => {}),
+				input: async () => undefined,
+				notify: vi.fn(),
+			},
+		});
+		const response = pending.handler(request({ type: "object", properties: {} }), { signal: controller.signal });
+		controller.abort(new Error("user cancelled"));
+		await expect(response).rejects.toThrow("user cancelled");
+	});
+});
