index 0000000000000000000000000000000000000000..b88adc062e1307039134bb4bb4379c16f1a8dcd4
--- /dev/null
+++ b/packages/mcp/src/transports/unix-socket.ts
@@ -0,0 +1,123 @@
+import { createConnection, type Socket } from "node:net";
+import {
+	type JsonRpcMessage,
+	McpAbortError,
+	McpConnectionClosedError,
+	parseJsonRpcMessage,
+} from "../protocol/jsonrpc.ts";
+import {
+	DEFAULT_MAX_MESSAGE_BYTES,
+	type McpTransport,
+	type McpTransportSendOptions,
+	TransportEvents,
+} from "./transport.ts";
+
+const DEFAULT_CLOSE_TIMEOUT_MS = 2_000;
+
+/** MCP JSON-RPC messages framed as newline-delimited JSON over an explicit Unix-domain socket. */
+export class UnixSocketTransport extends TransportEvents implements McpTransport {
+	private socket: Socket | undefined;
+	private input = Buffer.alloc(0);
+	private started = false;
+	private closed = false;
+	readonly socketPath: string;
+	private readonly maxMessageBytes: number;
+
+	constructor(socketPath: string, maxMessageBytes = DEFAULT_MAX_MESSAGE_BYTES) {
+		super();
+		this.socketPath = socketPath;
+		this.maxMessageBytes = maxMessageBytes;
+	}
+
+	async start(): Promise<void> {
+		if (this.started) throw new Error("MCP Unix socket transport already started");
+		if (this.closed) throw new McpConnectionClosedError();
+		this.started = true;
+		const socket = createConnection(this.socketPath);
+		this.socket = socket;
+		await new Promise<void>((resolve, reject) => {
+			let connected = false;
+			socket.on("data", (chunk: Buffer | string) => this.read(chunk));
+			socket.on("error", (error) => {
+				if (!connected) {
+					this.socket = undefined;
+					socket.destroy();
+					reject(error);
+				} else {
+					this.emitError(error);
+				}
+			});
+			socket.on("close", () => {
+				if (this.socket === socket) this.socket = undefined;
+				this.input = Buffer.alloc(0);
+				this.emitClose();
+			});
+			socket.once("connect", () => {
+				connected = true;
+				resolve();
+			});
+		});
+	}
+
+	async send(message: JsonRpcMessage, { signal }: McpTransportSendOptions = {}): Promise<void> {
+		const socket = this.socket;
+		if (!this.started || this.closed || !socket?.writable) throw new McpConnectionClosedError();
+		if (signal?.aborted) throw new McpAbortError();
+		const payload = `${JSON.stringify(message)}\n`;
+		await new Promise<void>((resolve, reject) => {
+			socket.write(payload, (error) => (error ? reject(error) : resolve()));
+		});
+	}
+
+	async close(): Promise<void> {
+		if (this.closed) return;
+		this.closed = true;
+		const socket = this.socket;
+		this.socket = undefined;
+		this.input = Buffer.alloc(0);
+		if (!socket || socket.destroyed) {
+			this.emitClose();
+			return;
+		}
+		await new Promise<void>((resolve) => {
+			const timeout = setTimeout(() => {
+				socket.destroy();
+				resolve();
+			}, DEFAULT_CLOSE_TIMEOUT_MS);
+			timeout.unref();
+			socket.once("close", () => {
+				clearTimeout(timeout);
+				resolve();
+			});
+			socket.end();
+		});
+		this.emitClose();
+	}
+
+	private read(chunk: Buffer | string): void {
+		this.input = Buffer.concat([this.input, Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)]);
+		while (true) {
+			const newline = this.input.indexOf(0x0a);
+			if (newline < 0) {
+				if (this.input.length > this.maxMessageBytes) {
+					this.input = Buffer.alloc(0);
+					this.emitError(new Error(`MCP socket message exceeds ${this.maxMessageBytes} bytes`));
+				}
+				return;
+			}
+			const line = this.input.subarray(0, newline);
+			this.input = this.input.subarray(newline + 1);
+			if (line.length > this.maxMessageBytes) {
+				this.emitError(new Error(`MCP socket message exceeds ${this.maxMessageBytes} bytes`));
+				continue;
+			}
+			const text = line.toString("utf8").replace(/\r$/, "");
+			if (!text.trim()) continue;
+			try {
+				this.emitMessage(parseJsonRpcMessage(JSON.parse(text)));
+			} catch (error) {
+				this.emitError(error);
+			}
+		}
+	}
+}
