+		expect(replacement.ok).toBe(true);
+		if (replacement.ok) replacement.value();
+	});
+
+	it("shares its installed assembly with the built-in owner across extension-loader module instances", async () => {
+		const host = createFakePiHost();
+		const assembly: McpOwnerAssembly = { loadConfig: () => loadedConfig([disabledEntry]) };
+		const jiti = createJiti(import.meta.url, { moduleCache: false, tryNative: false });
+		const duplicate = (await jiti.import(
+			new URL("../src/extensions/mcp/assembly.ts", import.meta.url).href,
+		)) as typeof import("../src/extensions/mcp/assembly.ts");
+		const result = duplicate.installMcpOwnerAssembly(assembly, host.events);
+		expect(result.ok).toBe(true);
+		if (!result.ok) return;
+		assemblyDisposers.push(result.value);
+
+		const handle = await startBuiltInOwner(host);
+		expect(handle.snapshot()).toMatchObject({
+			ok: true,
+			value: { servers: [{ name: "assembled", enabled: false, connectionStatus: "disabled" }] },
+		});
+	});
+
+	it("feeds the real built-in owner config and write-back from its assembly", async () => {
+		const writes: Array<{ entry: McpServerEntry; patch: McpServerConfigPatch }> = [];
+		install({
