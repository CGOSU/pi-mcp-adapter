+export function createMcpManagementSnapshot(servers: readonly McpManagementServerSnapshot[]): McpManagementSnapshot {
+	const snapshotServers = servers.map((server) => {
+		const tools = server.catalog.tools.map((tool) =>
+			Object.freeze({
+				name: tool.name,
+				...(tool.description === undefined ? {} : { description: tool.description }),
+				exposure: tool.exposure,
+				...(tool.appResourceId === undefined ? {} : { appResourceId: tool.appResourceId }),
+				...(tool.uiVisibility === undefined ? {} : { uiVisibility: Object.freeze([...tool.uiVisibility]) }),
+			}),
+		);
+		const resources = Object.freeze({
+			available: server.catalog.resources.available,
+			freshness: server.catalog.resources.freshness,
+			items: Object.freeze(
+				server.catalog.resources.items.map((resource) =>
+					Object.freeze({
+						id: resource.id,
+						name: resource.name,
+						...(resource.title === undefined ? {} : { title: resource.title }),
+						...(resource.description === undefined ? {} : { description: resource.description }),
+						...(resource.mimeType === undefined ? {} : { mimeType: resource.mimeType }),
+						...(resource.size === undefined ? {} : { size: resource.size }),
+						kind: resource.kind,
+						...(resource.ui === undefined ? {} : { ui: freezeAppResourceMetadata(resource.ui) }),
+					}),
+				),
+			),
+			templates: Object.freeze(
+				server.catalog.resources.templates.map((template) =>
+					Object.freeze({
+						id: template.id,
+						name: template.name,
+						...(template.title === undefined ? {} : { title: template.title }),
+						...(template.description === undefined ? {} : { description: template.description }),
+						...(template.mimeType === undefined ? {} : { mimeType: template.mimeType }),
+					}),
+				),
+			),
+		});
+		const prompts = Object.freeze({
+			available: server.catalog.prompts.available,
+			freshness: server.catalog.prompts.freshness,
+			items: Object.freeze(
+				server.catalog.prompts.items.map((prompt) =>
+					Object.freeze({
+						name: prompt.name,
+						...(prompt.title === undefined ? {} : { title: prompt.title }),
+						...(prompt.description === undefined ? {} : { description: prompt.description }),
+						arguments: Object.freeze(
+							prompt.arguments.map((argument) =>
+								Object.freeze({
+									name: argument.name,
+									...(argument.description === undefined ? {} : { description: argument.description }),
+									...(argument.required === undefined ? {} : { required: argument.required }),
+								}),
+							),
+						),
+					}),
+				),
+			),
+		});
+		const catalog = Object.freeze({
+			freshness: server.catalog.freshness,
+			tools: Object.freeze(tools),
+			resources,
+			prompts,
+		});
+		return Object.freeze({
+			name: server.name,
+			enabled: server.enabled,
+			scope: server.scope,
+			exposure: server.exposure,
+			...(server.directTools === undefined
+				? {}
+				: {
+						directTools: Array.isArray(server.directTools)
+							? Object.freeze([...server.directTools])
+							: server.directTools,
+					}),
+			connectionStatus: server.connectionStatus,
+			catalog,
+		});
+	});
+	return Object.freeze({
+		protocolVersion: MCP_MANAGEMENT_PROTOCOL_VERSION,
+		servers: Object.freeze(snapshotServers),
+	});
+}
