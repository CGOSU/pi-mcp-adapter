+	it("cancels idle reclamation when a lazy server is disabled", async () => {
+		const entry: McpServerEntry = {
+			name: "docs",
+			config: { command: "fixture", lifecycle: "lazy", idleTimeout: 0.005 },
+			source: "extension",
+			scope: "extension",
+		};
+		const result = await setup({ entries: [entry] });
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.catalog.freshness).toBe("live"));
+		const disabled = await result.handle.setServerEnabled("docs", false);
+		expect(disabled).toMatchObject({ ok: true, value: undefined });
+		await delay(400);
+		expect(snapshot(result.handle)[0]?.connectionStatus).toBe("disabled");
+		expect(result.transportCount()).toBe(1);
+	});
+
+	it("invalidates the old attempt and idle timer when a registered server is replaced", async () => {
+		const options: { entries: McpServerEntry[]; tools?: FakeTool[] } = { entries: [] };
+		const result = await setup(options);
+		const firstConfig: McpServerConfig = { command: "first-fixture", lifecycle: "lazy", idleTimeout: 0.005 };
+		result.host.setMcpServers([{ name: "docs", config: firstConfig, extensionPath: "fixture-extension" }]);
+		await result.host.emit("mcp_servers_change", { type: "mcp_servers_change" }, result.context);
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.catalog.freshness).toBe("live"));
+
+		options.tools = [
+			{ name: "lookup", description: "Replacement search", inputSchema: { type: "object", properties: {} } },
+		];
+		result.host.setMcpServers([
+			{
+				name: "docs",
+				config: { command: "replacement-fixture", lifecycle: "lazy", idleTimeout: 0 },
+				extensionPath: "fixture-extension",
+			},
+		]);
+		await result.host.emit("mcp_servers_change", { type: "mcp_servers_change" }, result.context);
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.catalog.tools[0]?.name).toBe("lookup"));
+		await delay(400);
+		expect(snapshot(result.handle)[0]).toMatchObject({
+			connectionStatus: "connected",
+			catalog: { freshness: "live", tools: [{ name: "lookup", description: "Replacement search" }] },
+		});
+		expect(result.transportCount()).toBe(2);
+	});
+
+	it("starts eager and keep-alive servers despite a valid seed and keeps lazy-keep-alive after first use", async () => {
+		const entries: McpServerEntry[] = [
+			{ name: "eager", config: { command: "fixture", lifecycle: "eager" }, source: "fixture" },
+			{ name: "kept", config: { command: "fixture", lifecycle: "keep-alive" }, source: "fixture" },
+		];
