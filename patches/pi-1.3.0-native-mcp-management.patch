+import { existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { type JsonRpcMessage, LATEST_PROTOCOL_VERSION } from "@earendil-works/pi-mcp";
+import { createInMemoryTransportPair, type InMemoryTransport } from "@earendil-works/pi-mcp/testing";
+import { afterEach, describe, expect, it } from "vitest";
+import { InMemoryAuthStorageBackend } from "../src/core/auth-storage.ts";
+import { createEventBus } from "../src/core/event-bus.ts";
+import type { ExtensionAPI, ExtensionContext, ExtensionFactory } from "../src/core/extensions/types.ts";
+import {
+	MCP_MANAGEMENT_DISCOVERY_EVENT,
+	MCP_MANAGEMENT_PROTOCOL_ID,
+	MCP_MANAGEMENT_PROTOCOL_VERSION,
+	MCP_MANAGEMENT_RESPONSE_EVENT_PREFIX,
+	type McpManagementDiscoveryResponse,
+	type McpManagementHandle,
+} from "../src/core/mcp-management.ts";
+import { validateMcpServerConfig } from "../src/core/mcp-servers.ts";
+import {
+	computeMcpCatalogConfigHash,
+	McpCatalogSeedStore,
+	type McpCatalogSeedTool,
+} from "../src/extensions/mcp/catalog-cache.ts";
+import { loadMcpConfig, type McpServerConfig, type McpServerEntry } from "../src/extensions/mcp/config.ts";
+import { createMcpExtension } from "../src/extensions/mcp/index.ts";
+import { DEFAULT_MCP_IDLE_TIMEOUT_MINUTES, McpLifecycleScheduler } from "../src/extensions/mcp/lifecycle.ts";
+import { McpOAuthCredentialStore } from "../src/extensions/mcp/runtime.ts";
+
+interface FakeTool {
+	name: string;
+	description?: string;
+	inputSchema: { type: "object"; properties: Record<string, never> };
+}
+
+interface DeferredToolResponse {
+	respond(): void;
+}
+
+interface FakeHost {
+	pi: ExtensionAPI;
+	tools: Map<string, unknown>;
+	events: ReturnType<typeof createEventBus>;
+	setMcpServers(servers: Array<{ name: string; config: McpServerConfig; extensionPath: string }>): void;
+	emit(event: string, data: unknown, context: unknown): Promise<void>;
+}
+
+const tool: FakeTool = { name: "search", description: "Live search", inputSchema: { type: "object", properties: {} } };
+const originalAgentDirectory = process.env.PI_CODING_AGENT_DIR;
+const hosts: FakeHost[] = [];
+const transports: InMemoryTransport[] = [];
+const directories: string[] = [];
+
+function createHost(): FakeHost {
+	const events = createEventBus();
+	const handlers = new Map<string, Array<(event: unknown, context: unknown) => unknown>>();
+	const tools = new Map<string, unknown>();
+	const commands = new Map<string, unknown>();
+	let registeredServers: Array<{ name: string; config: McpServerConfig; extensionPath: string }> = [];
+	let activeTools: string[] = [];
+	const pi = {
+		events,
+		on(event: string, handler: (data: unknown, context: unknown) => unknown) {
+			const listeners = handlers.get(event) ?? [];
+			listeners.push(handler);
+			handlers.set(event, listeners);
+			return () =>
+				handlers.set(
+					event,
+					listeners.filter((candidate) => candidate !== handler),
+				);
+		},
+		registerTool: (definition: { name: string }) => tools.set(definition.name, definition),
+		registerToolRenderer: () => {},
+		registerCommand: (name: string, definition: unknown) => commands.set(name, definition),
+		getAllTools: () => [...tools.values()],
+		getActiveTools: () => [...activeTools],
+		setActiveTools: (names: string[]) => {
+			activeTools = [...names];
+		},
+		getMcpServers: () => registeredServers,
+	} as unknown as ExtensionAPI;
+	return {
+		pi,
+		tools,
+		events,
+		setMcpServers(servers) {
+			registeredServers = servers;
+		},
+		async emit(event, data, context) {
+			await Promise.all((handlers.get(event) ?? []).map((handler) => handler(data, context)));
+		},
+	};
+}
+
+function readHandle(events: FakeHost["events"], requestId: string): McpManagementHandle | undefined {
+	let response: McpManagementDiscoveryResponse | undefined;
+	const unsubscribe = events.on(`${MCP_MANAGEMENT_RESPONSE_EVENT_PREFIX}${requestId}`, (data) => {
+		response = data as McpManagementDiscoveryResponse;
+	});
+	events.emit(MCP_MANAGEMENT_DISCOVERY_EVENT, {
+		protocol: MCP_MANAGEMENT_PROTOCOL_ID,
+		version: MCP_MANAGEMENT_PROTOCOL_VERSION,
+		requestId,
+		requiredCapabilities: [],
+	});
+	unsubscribe();
+	return response?.result.ok ? response.result.value : undefined;
+}
+
+function snapshot(handle: McpManagementHandle) {
+	const result = handle.snapshot();
+	if (!result.ok) throw new Error(result.error.message);
+	return result.value.servers;
+}
+
+function delay(milliseconds: number): Promise<void> {
+	return new Promise((resolve) => setTimeout(resolve, milliseconds));
+}
+
+async function setup(options: {
+	entries: McpServerEntry[];
+	seed?: boolean;
+	seedConfigs?: Array<{ name: string; config: McpServerConfig; tools: McpCatalogSeedTool[] }>;
+	globalIdleTimeout?: number;
+	projectTrust?: { value: boolean };
+	tools?: FakeTool[];
+	blockToolCalls?: boolean;
+}): Promise<{
+	host: FakeHost;
+	context: ExtensionContext;
+	handle: McpManagementHandle;
+	transportCount: () => number;
+	pendingResponses: DeferredToolResponse[];
+}> {
+	const directory = mkdtempSync(join(tmpdir(), "pi-mcp-lifecycle-"));
+	directories.push(directory);
+	const agentDirectory = join(directory, "agent");
+	const cwd = join(directory, "project");
+	mkdirSync(agentDirectory, { recursive: true });
+	mkdirSync(cwd, { recursive: true });
+	process.env.PI_CODING_AGENT_DIR = agentDirectory;
+	const host = createHost();
+	hosts.push(host);
+	const context = {
+		cwd,
+		modelRegistry: undefined,
+		isProjectTrusted: () => options.projectTrust?.value ?? true,
+		signal: new AbortController().signal,
+		ui: { notify: () => {} },
+	} as unknown as ExtensionContext;
+	const pendingResponses: DeferredToolResponse[] = [];
+	let connectionCount = 0;
+	const extension: ExtensionFactory = createMcpExtension({
+		loadConfig: () => ({
+			servers: options.entries,
+			errors: [],
+			...(options.globalIdleTimeout === undefined ? {} : { idleTimeout: options.globalIdleTimeout }),
+		}),
+		credentials: new McpOAuthCredentialStore(new InMemoryAuthStorageBackend()),
+		createTransport: () => {
+			connectionCount++;
+			const pair = createInMemoryTransportPair();
+			transports.push(pair.server);
+			pair.server.onMessage((message) => {
+				if (!("id" in message) || !("method" in message)) return;
+				if (message.method === "initialize") {
+					const response: JsonRpcMessage = {
+						jsonrpc: "2.0",
+						id: message.id,
+						result: {
+							protocolVersion: LATEST_PROTOCOL_VERSION,
+							capabilities: { tools: {} },
+							serverInfo: { name: "lifecycle-fixture", version: "1.0.0" },
+						},
+					};
+					queueMicrotask(() => void pair.server.send(response));
+					return;
+				}
+				if (message.method === "tools/list") {
+					const response: JsonRpcMessage = {
+						jsonrpc: "2.0",
+						id: message.id,
+						result: { tools: options.tools ?? [tool] },
+					};
+					queueMicrotask(() => void pair.server.send(response));
+					return;
+				}
+				if (message.method === "tools/call" && options.blockToolCalls) {
+					pendingResponses.push({
+						respond: () => {
+							const response: JsonRpcMessage = {
+								jsonrpc: "2.0",
+								id: message.id,
+								result: { content: [{ type: "text", text: "ok" }] },
+							};
+							void pair.server.send(response);
+						},
+					});
+					return;
+				}
+				const response: JsonRpcMessage = {
+					jsonrpc: "2.0",
+					id: message.id,
+					result: { content: [{ type: "text", text: "ok" }] },
+				};
+				queueMicrotask(() => void pair.server.send(response));
+			});
+			void pair.server.start();
+			return pair.client;
+		},
+	});
+	const cachePath = join(agentDirectory, "mcp-catalog-cache.json");
+	if (options.seed || options.seedConfigs) {
+		const store = new McpCatalogSeedStore(cachePath);
+		for (const entry of options.entries) {
+			const seeded = options.seedConfigs?.find((candidate) => candidate.name === entry.name);
+			const config = seeded?.config ?? entry.config;
+			const tools = seeded?.tools ?? [{ name: "search", description: "Cached search" }];
+			store.save(entry.name, computeMcpCatalogConfigHash(config, cwd), tools);
+		}
+	}
+	extension(host.pi);
+	await host.emit("session_start", { type: "session_start" }, context);
+	const handle = readHandle(host.events, "lifecycle-session");
+	if (!handle) throw new Error("Native MCP management handle was not available");
+	return { host, context, handle, transportCount: () => connectionCount, pendingResponses };
+}
+
+afterEach(async () => {
+	for (const host of hosts.splice(0)) {
+		await host.emit("session_shutdown", { type: "session_shutdown", reason: "test" }, undefined);
+		host.events.clear();
+	}
+	for (const transport of transports.splice(0)) await transport.close();
+	for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true });
+	if (originalAgentDirectory === undefined) delete process.env.PI_CODING_AGENT_DIR;
+	else process.env.PI_CODING_AGENT_DIR = originalAgentDirectory;
+});
+
+describe("opt-in native MCP lifecycle", () => {
+	it("keeps stock startup behavior without persisting a lifecycle seed", async () => {
+		const entry: McpServerEntry = { name: "docs", config: { command: "fixture" }, source: "fixture" };
+		const result = await setup({ entries: [entry] });
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.catalog.freshness).toBe("live"));
+		expect(result.transportCount()).toBe(1);
+		expect(existsSync(join(process.env.PI_CODING_AGENT_DIR!, "mcp-catalog-cache.json"))).toBe(false);
+	});
+
+	it("keeps the cold-cache bootstrap and persists a validated seed", async () => {
+		const entry: McpServerEntry = {
+			name: "docs",
+			config: { command: "fixture", lifecycle: "lazy" },
+			source: "fixture",
+		};
+		const result = await setup({ entries: [entry] });
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.catalog.freshness).toBe("live"));
+		expect(result.transportCount()).toBe(1);
+		const path = join(process.env.PI_CODING_AGENT_DIR!, "mcp-catalog-cache.json");
+		expect(existsSync(path)).toBe(true);
+	});
+
+	it("loads a valid offline seed lazily and coalesces concurrent management reconnects", async () => {
+		const entry: McpServerEntry = {
+			name: "docs",
+			config: { command: "fixture", lifecycle: "lazy" },
+			source: "fixture",
+		};
+		const result = await setup({ entries: [entry], seed: true });
+		expect(result.transportCount()).toBe(0);
+		expect(snapshot(result.handle)[0]).toMatchObject({
+			connectionStatus: "disconnected",
+			catalog: { freshness: "cached", tools: [{ name: "search", description: "Cached search" }] },
+		});
+
+		const outcomes = await Promise.all([
+			result.handle.reconnectServer("docs"),
+			result.handle.reconnectServer("docs"),
