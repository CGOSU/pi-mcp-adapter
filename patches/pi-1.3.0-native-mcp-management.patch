+				schema.minItems > schema.maxItems
+			) {
+				throw invalidParams(`Elicitation field ${name} minItems exceeds maxItems.`);
+			}
+			if (schema.uniqueItems !== undefined && typeof schema.uniqueItems !== "boolean") {
+				throw invalidParams(`Elicitation field ${name} uniqueItems must be a boolean.`);
+			}
+		}
+		properties[name] = schema;
+	}
+	if (
+		value.required !== undefined &&
+		(!stringArray(value.required) || value.required.some((name) => !Object.hasOwn(properties, name)))
+	) {
+		throw invalidParams("Form elicitation required must name declared fields.");
+	}
+	return {
+		type: "object",
+		properties,
+		...(value.required === undefined ? {} : { required: value.required as string[] }),
+	};
+}
+
+function enumChoices(schema: Record<string, unknown>): Array<{ value: string; display: string }> {
+	if (Array.isArray(schema.oneOf)) {
+		return schema.oneOf.filter(isRecord).map((option) => {
+			const value = String(option.const);
+			return {
+				value,
+				display: safeUiText(
+					typeof option.title === "string" && option.title !== value ? `${option.title} (${value})` : value,
+				),
+			};
+		});
+	}
+	if (Array.isArray(schema.enum)) {
+		return schema.enum.map((value, index) => {
+			const name = Array.isArray(schema.enumNames) ? schema.enumNames[index] : undefined;
+			const actual = String(value);
+			return {
+				value: actual,
+				display: safeUiText(typeof name === "string" && name !== actual ? `${name} (${actual})` : actual),
+			};
+		});
+	}
+	return [];
+}
+
+function uniqueLabels(labels: string[]): string[] {
+	const used = new Set<string>();
+	return labels.map((label) => {
+		let unique = label;
+		while (used.has(unique)) unique += "…";
+		used.add(unique);
+		return unique;
+	});
+}
+
+function uniqueAction(label: string, choices: readonly string[]): string {
+	let unique = label;
+	while (choices.includes(unique)) unique += "…";
+	return unique;
+}
+
+function humanize(name: string): string {
+	return name
+		.replace(/[_-]+/g, " ")
+		.replace(/([a-z0-9])([A-Z])/g, "$1 $2")
+		.replace(/^./, (character) => character.toUpperCase());
+}
+
+function arrayChoices(schema: Record<string, unknown>): Array<{ value: string; display: string }> {
+	const items = schema.items;
+	if (!isRecord(items)) return [];
+	if (Array.isArray(items.anyOf)) {
+		return items.anyOf.filter(isRecord).map((option) => {
+			const value = String(option.const);
+			return {
+				value,
+				display: safeUiText(
+					typeof option.title === "string" && option.title !== value ? `${option.title} (${value})` : value,
+				),
+			};
+		});
+	}
+	return Array.isArray(items.enum)
+		? items.enum.map((value) => ({ value: String(value), display: safeUiText(String(value)) }))
+		: [];
+}
+
+function validFormat(value: string, format: string): boolean {
+	if (format === "email") return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
+	if (format === "uri") return URL.canParse(value);
+	if (format === "date") {
+		if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+		try {
+			return new Date(`${value}T00:00:00.000Z`).toISOString().slice(0, 10) === value;
+		} catch {
+			return false;
+		}
+	}
+	return format === "date-time" && value.includes("T") && Number.isFinite(Date.parse(value));
+}
+
+function validateField(
+	name: string,
+	schema: Record<string, unknown>,
+	value: McpElicitationValue,
+	required: boolean,
+): string | number | boolean | string[] | undefined {
+	if (value === undefined) {
+		if (required) throw invalidParams(`Missing required elicitation field: ${name}`);
+		return undefined;
+	}
+	if (schema.type === "string") {
+		if (typeof value !== "string") throw invalidParams(`Elicitation field ${name} must be text.`);
+		const result = value;
+		if (typeof schema.minLength === "number" && result.length < schema.minLength)
+			throw invalidParams(`Elicitation field ${name} is shorter than its minimum length.`);
+		if (typeof schema.maxLength === "number" && result.length > schema.maxLength)
+			throw invalidParams(`Elicitation field ${name} is longer than its maximum length.`);
+		const choices = enumChoices(schema).map((choice) => choice.value);
+		if ((Array.isArray(schema.enum) || Array.isArray(schema.oneOf)) && !choices.includes(result))
+			throw invalidParams(`Elicitation field ${name} is not an allowed value.`);
+		if (typeof schema.format === "string" && !validFormat(result, schema.format))
+			throw invalidParams(`Elicitation field ${name} does not match ${schema.format} format.`);
+		return result;
+	}
+	if (schema.type === "number" || schema.type === "integer") {
+		if (typeof value !== "number" && typeof value !== "string")
+			throw invalidParams(`Elicitation field ${name} must be a number.`);
+		if (typeof value === "string" && !value.trim())
+			throw invalidParams(`Elicitation field ${name} must be a number.`);
+		const result = typeof value === "number" ? value : Number(value);
+		if (!Number.isFinite(result) || (schema.type === "integer" && !Number.isInteger(result)))
+			throw invalidParams(`Elicitation field ${name} has an invalid number.`);
+		if (typeof schema.minimum === "number" && result < schema.minimum)
+			throw invalidParams(`Elicitation field ${name} is below its minimum.`);
+		if (typeof schema.maximum === "number" && result > schema.maximum)
+			throw invalidParams(`Elicitation field ${name} exceeds its maximum.`);
+		return result;
+	}
+	if (schema.type === "boolean") {
+		if (typeof value !== "boolean" && value !== "true" && value !== "false")
+			throw invalidParams(`Elicitation field ${name} must be a boolean.`);
+		return typeof value === "boolean" ? value : value === "true";
+	}
+	if (!Array.isArray(value) || value.some((item) => typeof item !== "string"))
+		throw invalidParams(`Elicitation field ${name} must be a list of strings.`);
+	const choices = arrayChoices(schema);
+	const result = [...value] as string[];
+	if (typeof schema.minItems === "number" && result.length < schema.minItems)
+		throw invalidParams(`Elicitation field ${name} has too few selections.`);
+	if (typeof schema.maxItems === "number" && result.length > schema.maxItems)
+		throw invalidParams(`Elicitation field ${name} has too many selections.`);
+	if (result.some((item) => !choices.some((choice) => choice.value === item)))
+		throw invalidParams(`Elicitation field ${name} has an invalid selection.`);
+	if (schema.uniqueItems === true && new Set(result).size !== result.length)
+		throw invalidParams(`Elicitation field ${name} contains duplicate selections.`);
+	return result;
+}
+
+async function collectField(
+	options: McpElicitationHandlerOptions,
+	message: string,
+	name: string,
+	schema: Record<string, unknown>,
+	required: boolean,
+	current: McpElicitationValue,
+	signal: AbortSignal,
+): Promise<FieldCollectionResult> {
+	const ui = options.ui;
+	if (!ui) throw new Error("MCP elicitation requires an interactive UI; no response was accepted.");
+	const title = [
+		safeUiText(typeof schema.title === "string" ? schema.title : humanize(name)),
+		required ? "(required)" : "",
+		typeof schema.description === "string" ? safeUiText(schema.description) : "",
+	]
+		.filter(Boolean)
+		.join(" ");
+	if (schema.type === "string" && (Array.isArray(schema.enum) || Array.isArray(schema.oneOf))) {
+		const choices = enumChoices(schema);
+		const displays = uniqueLabels(choices.map((choice) => choice.display));
+		const actions = [...displays];
+		const useDefault = schema.default === undefined ? undefined : uniqueAction("Use default", actions);
+		if (useDefault) actions.push(useDefault);
+		const omit = required ? undefined : uniqueAction("Omit", actions);
+		if (omit) actions.push(omit);
+		const choice = await awaitWithSignal(
+			ui.select(`${title}\n\n${safeUiText(message)}`, actions, { signal }),
+			signal,
+		);
+		if (choice === undefined) return { status: "cancelled" };
+		if (choice === useDefault) return { status: "collected", value: schema.default as McpElicitationValue };
+		if (choice === omit) return { status: "collected", value: undefined };
+		return { status: "collected", value: choices[displays.indexOf(choice)]?.value };
+	}
+	if (schema.type === "boolean") {
+		const actions = ["Yes", "No"];
+		if (schema.default !== undefined) actions.push("Use default");
+		if (!required) actions.push("Omit");
+		const choice = await awaitWithSignal(ui.select(title, actions, { signal }), signal);
+		if (choice === undefined) return { status: "cancelled" };
+		if (choice === "Use default") return { status: "collected", value: schema.default as McpElicitationValue };
+		if (choice === "Omit") return { status: "collected", value: undefined };
+		return { status: "collected", value: choice === "Yes" };
+	}
+	if (schema.type === "array") {
+		const choices = arrayChoices(schema);
+		if (choices.length === 0) throw invalidParams(`Elicitation field ${name} has no supported list choices.`);
+		const action = await awaitWithSignal(
+			ui.select(
+				title,
+				["Choose values", ...(schema.default === undefined ? [] : ["Use default"]), ...(!required ? ["Omit"] : [])],
+				{ signal },
+			),
+			signal,
+		);
+		if (action === undefined) return { status: "cancelled" };
+		if (action === "Use default") return { status: "collected", value: schema.default as McpElicitationValue };
+		if (action === "Omit") return { status: "collected", value: undefined };
+		const selected = new Set(Array.isArray(current) ? current : []);
+		for (;;) {
+			const labels = uniqueLabels(
+				choices.map((choice) => (selected.has(choice.value) ? `✓ ${choice.display}` : choice.display)),
+			);
+			const done = uniqueAction("Done", labels);
+			const picked = await awaitWithSignal(ui.select(title, [...labels, done], { signal }), signal);
+			if (picked === undefined) return { status: "cancelled" };
+			if (picked === done) return { status: "collected", value: [...selected] };
+			const index = labels.indexOf(picked);
+			const choice = choices[index];
+			if (!choice) continue;
+			if (selected.has(choice.value)) selected.delete(choice.value);
+			else selected.add(choice.value);
+		}
+	}
+	const actions = ["Enter value"];
+	if (schema.default !== undefined) actions.push("Use default");
+	if (!required) actions.push("Omit");
+	const action = await awaitWithSignal(ui.select(title, actions, { signal }), signal);
+	if (action === undefined) return { status: "cancelled" };
+	if (action === "Use default") return { status: "collected", value: schema.default as McpElicitationValue };
+	if (action === "Omit") return { status: "collected", value: undefined };
+	const value = await awaitWithSignal(
+		ui.input(title, current === undefined ? undefined : String(current), { signal }),
+		signal,
+	);
+	return value === undefined ? { status: "cancelled" } : { status: "collected", value };
+}
+
+async function collectValidField(
+	options: McpElicitationHandlerOptions,
+	message: string,
+	name: string,
+	schema: Record<string, unknown>,
+	required: boolean,
+	current: McpElicitationValue,
+	signal: AbortSignal,
+): Promise<FieldCollectionResult> {
+	const ui = options.ui;
+	if (!ui) throw new Error("MCP elicitation requires an interactive UI; no response was accepted.");
+	let previous = current;
+	for (;;) {
+		const result = await collectField(options, message, name, schema, required, previous, signal);
+		if (result.status === "cancelled") return result;
+		try {
+			validateField(name, schema, result.value, required);
+			return result;
+		} catch (error) {
+			const message = error instanceof Error ? safeUiText(error.message) : "The field value is invalid.";
+			ui.notify(message, "error");
+			previous = result.value;
+		}
+	}
+}
+
+async function handleForm(options: McpElicitationHandlerOptions, params: Record<string, unknown>, signal: AbortSignal) {
+	const requestedSchema = schemaOf(params.requestedSchema);
+	if (!options.ui) throw new Error("MCP elicitation requires an interactive UI; no response was accepted.");
+	if (typeof params.message !== "string" || params.message.length > 16_384) {
+		throw invalidParams("Form elicitation message must be a string of at most 16384 characters.");
+	}
+	const message = safeUiText(params.message);
+	const decision = await awaitWithSignal(
+		options.ui.select(
+			`MCP Input Request\nServer: ${safeUiText(options.serverName)}\n\n${message}`,
+			["Continue", "Decline"],
+			{ signal },
+		),
+		signal,
+	);
+	if (decision === undefined) return { action: "cancel" as const };
+	if (decision === "Decline") return { action: "decline" as const };
+	const properties = Object.entries(requestedSchema.properties);
+	if (properties.length === 0) return { action: "accept" as const, content: {} };
+	const required = new Set(requestedSchema.required ?? []);
+	const values: Record<string, McpElicitationValue> = {};
+	for (const [name, schema] of properties) {
+		const result = await collectValidField(options, message, name, schema, required.has(name), undefined, signal);
+		if (result.status === "cancelled") return { action: "cancel" as const };
+		values[name] = result.value;
+	}
+	for (;;) {
+		const content: Record<string, string | number | boolean | string[]> = {};
+		for (const [name, schema] of properties) {
+			const value = validateField(name, schema, values[name], required.has(name));
+			if (value !== undefined) content[name] = value;
+		}
+		const rows = properties.map(
+			([name, schema]) =>
+				`${safeUiText(typeof schema.title === "string" ? schema.title : humanize(name))}: ${safeUiText(content[name] === undefined ? "(omitted)" : String(content[name]))}`,
+		);
+		const action = await awaitWithSignal(
+			options.ui.select(
+				[`Review input for ${safeUiText(options.serverName)}`, "", ...rows].join("\n"),
+				["Submit", "Edit", "Decline"],
+				{ signal },
+			),
+			signal,
+		);
+		if (action === undefined) return { action: "cancel" as const };
+		if (action === "Decline") return { action: "decline" as const };
+		if (action === "Submit") return { action: "accept" as const, content };
+		const labels = properties.map(
+			([name, schema]) =>
+				`${safeUiText(typeof schema.title === "string" ? schema.title : humanize(name))} (${safeUiText(name)})`,
+		);
+		const selected = await awaitWithSignal(options.ui.select("Choose a field to edit", labels, { signal }), signal);
+		if (selected === undefined) return { action: "cancel" as const };
+		const [name, schema] = properties[labels.indexOf(selected)] ?? [];
+		if (!name || !schema) continue;
+		const result = await collectValidField(options, message, name, schema, required.has(name), values[name], signal);
+		if (result.status === "cancelled") return { action: "cancel" as const };
+		values[name] = result.value;
+	}
+}
+
+async function handleUrl(options: McpElicitationHandlerOptions, params: Record<string, unknown>, signal: AbortSignal) {
+	if (!options.allowUrl) throw invalidParams("URL elicitation is not available in this Pi mode.");
+	if (
+		typeof params.url !== "string" ||
+		typeof params.message !== "string" ||
+		typeof params.elicitationId !== "string"
+	) {
+		throw invalidParams("URL elicitation requires a URL, message, and elicitationId.");
+	}
+	if (
+		params.url.length > 8_192 ||
+		params.message.length > 16_384 ||
+		!params.elicitationId ||
+		params.elicitationId.length > 256
+	) {
+		throw invalidParams("URL elicitation fields exceed the supported length limits.");
+	}
+	let url: URL;
+	try {
+		url = new URL(params.url);
+	} catch {
+		throw invalidParams("URL elicitation supplied an invalid URL.");
+	}
+	if (url.protocol !== "http:" && url.protocol !== "https:")
+		throw invalidParams("URL elicitation only supports HTTP and HTTPS URLs.");
+	if (url.username || url.password) throw invalidParams("URL elicitation URLs cannot contain embedded credentials.");
+	if (!options.ui) throw new Error("MCP URL elicitation requires an interactive UI; no browser was opened.");
+	const decision = await awaitWithSignal(
+		options.ui.select(
+			[
+				"MCP Browser Request",
+				`Server: ${safeUiText(options.serverName)}`,
+				"",
+				safeUiText(params.message),
+				"",
+				`Host: ${safeUiText(url.host)}`,
+				`Full URL: ${safeUiText(url.href)}`,
+				"",
+				"Open this URL in your browser?",
+			].join("\n"),
+			["Open", "Decline"],
+			{ signal },
+		),
+		signal,
+	);
+	if (decision === undefined) return { action: "cancel" as const };
+	if (decision === "Decline") return { action: "decline" as const };
+	try {
+		options.openUrl(url.href);
+	} catch {
+		options.ui.notify("Could not open the MCP elicitation URL.", "error");
+		return { action: "cancel" as const };
+	}
+	options.onUrlAccepted?.(params.elicitationId);
+	options.ui.notify("Opened browser for MCP elicitation.", "info");
+	return { action: "accept" as const };
+}
+
+export function registerMcpElicitationHandler(client: McpClient, options: McpElicitationHandlerOptions): void {
+	client.setRequestHandler("elicitation/create", (value, context) => {
+		if (!isRecord(value)) throw invalidParams("MCP elicitation params must be an object.");
+		return value.mode === "url"
+			? handleUrl(options, value, context.signal)
+			: handleForm(options, value, context.signal);
+	});
+}
diff --git a/packages/coding-agent/src/extensions/mcp/execution-policy.ts b/packages/coding-agent/src/extensions/mcp/execution-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b004e7c0a44540735c3acc0e02efaabf98af297b
--- /dev/null
+++ b/packages/coding-agent/src/extensions/mcp/execution-policy.ts
@@ -0,0 +1,205 @@
+import { createHash } from "node:crypto";
+import type { McpManagementExecutionPolicy } from "../../core/mcp-management.ts";
+import { getMcpToolExposure, type McpExposure, type McpServerEntry } from "./config.ts";
+
+export interface McpToolCandidate {
+	readonly server: McpServerEntry;
+	readonly name: string;
+}
+
+function serverPrefix(serverName: string, mode: NonNullable<McpManagementExecutionPolicy["toolPrefix"]>): string {
+	const sanitize = (value: string) =>
+		Array.from(value, (character) =>
+			/^[A-Za-z0-9_-]$/.test(character) ? character : `_${character.codePointAt(0)!.toString(16)}_`,
+		).join("");
+	if (mode === "none") return "";
+	if (mode === "short") return sanitize(serverName.replace(/-?mcp$/i, "")) || "mcp";
+	if (mode === "mcp") return `mcp__${sanitize(serverName)}`;
+	return sanitize(serverName);
+}
+
+export function formatAdapterToolName(
+	serverName: string,
+	toolName: string,
+	policy: McpManagementExecutionPolicy,
+): string {
+	const mode = policy.toolPrefix ?? "server";
+	const prefix = serverPrefix(serverName, mode);
+	const name = toolName.replace(/\./g, "_");
+	return prefix ? `${prefix}_${name}` : name;
+}
+
+export function assignAdapterToolName(
+	serverName: string,
+	toolName: string,
+	policy: McpManagementExecutionPolicy,
+	isTaken: (name: string) => boolean,
+): string {
+	const base = formatAdapterToolName(serverName, toolName, policy);
+	if (base.length <= 64 && !isTaken(base)) return base;
+	const suffix = createHash("sha256").update(`${serverName}\0${toolName}`).digest("hex").slice(0, 8);
+	return `${base.slice(0, 55)}_${suffix}`;
+}
+
+function legacyToolName(
+	toolName: string,
+	serverName: string,
+	mode: NonNullable<McpManagementExecutionPolicy["toolPrefix"]>,
+): string {
+	const prefix = serverPrefix(serverName, mode);
+	const name = toolName.replace(/[.-]/g, "_");
+	return prefix ? `${prefix}_${name}` : name;
+}
+
+function candidateNames(toolName: string, server: McpServerEntry, includeLegacy: boolean): Set<string> {
+	const policy = server.executionPolicy;
+	if (!policy) return new Set([toolName]);
+	const modes = [policy.toolPrefix ?? "server", "server", "short", "mcp"] as const;
+	const candidates = new Set<string>([toolName]);
+	for (const mode of modes) {
+		candidates.add(formatAdapterToolName(server.name, toolName, { toolPrefix: mode }));
+	}
+	if (!includeLegacy) return candidates;
+	const legacyName = toolName.replace(/-/g, "_");
+	candidates.add(legacyName);
+	for (const mode of modes) {
+		candidates.add(formatAdapterToolName(server.name, legacyName, { toolPrefix: mode }));
+		candidates.add(legacyToolName(toolName, server.name, mode));
+		candidates.add(formatAdapterToolName(server.name, toolName, { toolPrefix: mode }).replace(/-/g, "_"));
+	}
+	return candidates;
+}
+
+function matcher(pattern: string): RegExp {
+	const escaped = pattern
+		.replace(/[.+^${}()|[\]\\]/g, "\\$&")
+		.replace(/\*/g, ".*")
+		.replace(/\?/g, ".");
+	return new RegExp(`^${escaped}$`);
+}
+
+function matches(candidates: ReadonlySet<string>, pattern: string): boolean {
+	if (!pattern.includes("*") && !pattern.includes("?")) return candidates.has(pattern);
+	const expression = matcher(pattern);
+	for (const candidate of candidates) if (expression.test(candidate)) return true;
+	return false;
+}
+
+function matchesPatterns(
+	toolName: string,
+	server: McpServerEntry,
+	patterns: readonly string[] | undefined,
+	allTools: readonly McpToolCandidate[],
+): boolean {
+	if (!patterns || patterns.length === 0) return false;
+	const current = candidateNames(toolName, server, false);
+	if (patterns.some((pattern) => matches(current, pattern))) return true;
+	const legacy = candidateNames(toolName, server, true);
+	for (const candidate of current) legacy.delete(candidate);
+	return patterns.some((pattern) => {
+		if (!matches(legacy, pattern)) return false;
+		for (const other of allTools) {
+			if (other.server.name === server.name && other.name === toolName) continue;
+			if (matches(candidateNames(other.name, other.server, false), pattern)) return false;
+		}
+		return true;
+	});
+}
+
+export function isMcpToolAllowed(
+	server: McpServerEntry,
+	toolName: string,
+	allTools: readonly McpToolCandidate[],
+	resource = false,
+): boolean {
+	const policy = server.executionPolicy;
+	if (!policy) return true;
+	if (resource && policy.exposeResources === false) return false;
+	if (policy.includeTools?.length && !matchesPatterns(toolName, server, policy.includeTools, allTools)) return false;
+	return !matchesPatterns(toolName, server, policy.excludeTools, allTools);
+}
+
+function envDirectSelection(serverName: string): { all: boolean; tools: ReadonlySet<string> } | undefined {
+	const raw = process.env.MCP_DIRECT_TOOLS;
+	if (raw === undefined) return undefined;
+	if (raw === "__none__") return { all: false, tools: new Set() };
+	let all = false;
+	const tools = new Set<string>();
+	for (let selector of raw
+		.split(",")
+		.map((item) => item.trim())
+		.filter(Boolean)) {
+		selector = selector.replace(/\/+$/, "");
+		if (!selector.includes("/")) {
+			if (selector === serverName) all = true;
+			continue;
+		}
+		const [server, tool] = selector.split("/", 2);
+		if (server !== serverName) continue;
+		if (tool) tools.add(tool);
+		else all = true;
+	}
+	return { all, tools };
+}
+
