+): McpManagementResult<never> {
+	return { ok: false, error: { code, message, ...(details ? { details } : {}) } };
+}
+
+/** Copies only protocol fields and recursively freezes every snapshot collection. */
+function freezeAppResourceMetadata(value: McpManagementAppResourceMetadata): McpManagementAppResourceMetadata {
+	const csp = value.csp
+		? Object.freeze({
+				...(value.csp.resourceDomains === undefined
+					? {}
+					: { resourceDomains: Object.freeze([...value.csp.resourceDomains]) }),
+				...(value.csp.connectDomains === undefined
+					? {}
+					: { connectDomains: Object.freeze([...value.csp.connectDomains]) }),
+				...(value.csp.frameDomains === undefined
+					? {}
+					: { frameDomains: Object.freeze([...value.csp.frameDomains]) }),
+				...(value.csp.baseUriDomains === undefined
+					? {}
+					: { baseUriDomains: Object.freeze([...value.csp.baseUriDomains]) }),
+			})
+		: undefined;
+	const permissions = value.permissions ? Object.freeze({ ...value.permissions }) : undefined;
+	return Object.freeze({
+		...(csp === undefined ? {} : { csp }),
+		...(permissions === undefined ? {} : { permissions }),
+		...(value.domain === undefined ? {} : { domain: value.domain }),
+		...(value.prefersBorder === undefined ? {} : { prefersBorder: value.prefersBorder }),
+	});
+}
