+		const outputs = await Promise.all([
+			registered.execute("after-idle-one", {}, new AbortController().signal),
+			registered.execute("after-idle-two", {}, new AbortController().signal),
+		]);
+		expect(outputs.map((output) => output.content[0]?.text)).toEqual(["ok", "ok"]);
+		expect(result.transportCount()).toBe(2);
+	});
+
+	it("does not reclaim a server while its tool request is active", async () => {
+		const entry: McpServerEntry = {
+			name: "docs",
+			config: { command: "fixture", lifecycle: "lazy", idleTimeout: 0.005 },
+			source: "fixture",
+		};
+		const result = await setup({ entries: [entry], blockToolCalls: true });
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.catalog.freshness).toBe("live"));
