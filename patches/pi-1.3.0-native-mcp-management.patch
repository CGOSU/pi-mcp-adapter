+
+function server(approveTools: NonNullable<McpServerEntry["executionPolicy"]>["approveTools"] = true): McpServerEntry {
+	return {
+		name: "docs",
+		config: { command: "fixture" },
+		executionPolicy: { approveTools },
+		source: "/tmp/mcp-approval-test/mcp.json",
+		scope: "global",
+	};
+}
+
+function broker(decision: McpToolApprovalDecision) {
+	let requests = 0;
+	let captured: McpToolApprovalRequest | undefined;
+	return {
+		get requests() {
+			return requests;
+		},
+		get captured() {
+			return captured;
+		},
+		events: {
+			emit(event: string, data: unknown) {
+				if (event !== MCP_TOOL_APPROVAL_REQUEST_EVENT) return;
+				requests++;
+				captured = data as McpToolApprovalRequest;
+				captured.claim(() => decision);
+			},
+		},
+	};
