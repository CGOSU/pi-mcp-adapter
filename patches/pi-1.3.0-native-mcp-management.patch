+async function sseFixture(): Promise<SseFixture> {
+	const stats: FixtureStats = { streamablePosts: 0, sseGets: 0, ssePosts: 0, authorizationHeaders: [] };
+	const eventStreams = new Set<ServerResponse>();
+	const server = createServer((request, response) => {
+		if (request.method === "GET" && request.url === "/mcp") {
+			stats.sseGets++;
+			stats.authorizationHeaders.push(request.headers.authorization ?? "");
+			response.writeHead(200, {
+				"content-type": "text/event-stream",
+				"cache-control": "no-cache",
+				connection: "keep-alive",
+			});
+			response.flushHeaders();
+			eventStreams.add(response);
+			response.on("close", () => eventStreams.delete(response));
+			response.write("event: endpoint\ndata: /messages\n\n");
+			return;
+		}
+		if (request.method !== "POST") {
+			response.writeHead(404).end();
+			return;
+		}
+		stats.authorizationHeaders.push(request.headers.authorization ?? "");
+		const chunks: Buffer[] = [];
+		request.on("data", (chunk: Buffer | string) => chunks.push(Buffer.from(chunk)));
+		request.on("end", () => {
+			if (request.url === "/mcp") {
+				stats.streamablePosts++;
+				response.writeHead(404).end("legacy SSE fixture");
+				return;
+			}
+			if (request.url !== "/messages") {
+				response.writeHead(404).end();
+				return;
+			}
+			stats.ssePosts++;
+			const message = JSON.parse(Buffer.concat(chunks).toString("utf8")) as {
+				id?: string | number;
+				method?: string;
+			};
