+import type { McpOAuthState } from "@earendil-works/pi-mcp/oauth";
+import { createJiti } from "jiti";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ENV_AGENT_DIR } from "../src/config.ts";
+import { InMemoryAuthStorageBackend } from "../src/core/auth-storage.ts";
+import { createEventBus, type EventBusController } from "../src/core/event-bus.ts";
+import type { ExtensionAPI, ExtensionContext } from "../src/core/extensions/types.ts";
+import {
+	MCP_MANAGEMENT_DISCOVERY_EVENT,
+	MCP_MANAGEMENT_PROTOCOL_ID,
+	MCP_MANAGEMENT_PROTOCOL_VERSION,
+	MCP_MANAGEMENT_RESPONSE_EVENT_PREFIX,
+	type McpManagementDiscoveryResponse,
+} from "../src/core/mcp-management.ts";
+import {
+	installMcpOwnerAssembly,
+	type McpOwnerAssembly,
+	type McpOwnerAssemblyResult,
+} from "../src/extensions/mcp/assembly.ts";
+import type { LoadedMcpConfig, McpServerConfigPatch, McpServerEntry } from "../src/extensions/mcp/config.ts";
+import nativeMcpExtension from "../src/extensions/mcp/index.ts";
+import { type McpOAuthCredentialBackend, McpOAuthCredentialStore } from "../src/extensions/mcp/oauth.ts";
+import { startOAuthMcpServer } from "./suite/mcp-oauth-server.ts";
+
+interface FakePiHost {
+	pi: ExtensionAPI;
+	events: EventBusController;
+	context: ExtensionContext;
+	setRegisteredServers(
+		servers: Array<{ name: string; config: McpServerEntry["config"]; extensionPath: string }>,
+	): void;
+	emit(event: string, value: unknown): Promise<void>;
+}
+
+const hosts: FakePiHost[] = [];
+const assemblyDisposers: Array<() => void> = [];
+const httpServers: ReturnType<typeof createServer>[] = [];
+const tempDirs: string[] = [];
+let agentDir: string;
+
+beforeEach(() => {
+	const root = mkdtempSync(join(tmpdir(), "pi-mcp-owner-assembly-"));
+	tempDirs.push(root);
+	agentDir = join(root, "agent");
+	mkdirSync(agentDir, { recursive: true });
+	vi.stubEnv(ENV_AGENT_DIR, agentDir);
+});
+
+afterEach(async () => {
+	for (const host of hosts) {
+		await host.emit("session_shutdown", { type: "session_shutdown", reason: "quit" });
+	}
+	for (const dispose of assemblyDisposers.splice(0)) dispose();
+	for (const host of hosts.splice(0)) host.events.clear();
+	for (const server of httpServers.splice(0)) {
+		if (server.listening)
+			await new Promise<void>((resolve, reject) => server.close((error) => (error ? reject(error) : resolve())));
+	}
+	vi.unstubAllEnvs();
+	for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function createFakePiHost(): FakePiHost {
+	const events = createEventBus();
+	const handlers = new Map<string, Array<(event: unknown, context: unknown) => unknown>>();
+	const tools = new Map<string, unknown>();
+	const commands = new Map<string, unknown>();
+	let registeredServers: Array<{ name: string; config: McpServerEntry["config"]; extensionPath: string }> = [];
+	let activeTools: string[] = [];
+	const pi = {
+		events,
+		on: (event: string, handler: (event: unknown, context: unknown) => unknown) => {
+			const eventHandlers = handlers.get(event) ?? [];
+			eventHandlers.push(handler);
+			handlers.set(event, eventHandlers);
+			return () =>
+				handlers.set(
+					event,
+					eventHandlers.filter((current) => current !== handler),
+				);
+		},
+		registerTool: (tool: { name: string }) => tools.set(tool.name, tool),
+		registerToolRenderer: () => {},
+		registerCommand: (name: string, command: unknown) => commands.set(name, command),
+		getAllTools: () => [...tools.values()],
+		getActiveTools: () => [...activeTools],
+		setActiveTools: (names: string[]) => {
+			activeTools = [...names];
+		},
+		getMcpServers: () => registeredServers,
+	} as unknown as ExtensionAPI;
+	const context = {
+		cwd: "/tmp/pi-mcp-owner-assembly-project",
+		modelRegistry: undefined,
+		isProjectTrusted: () => false,
+		signal: new AbortController().signal,
+		hasUI: false,
+		ui: { notify: () => {} },
+	} as unknown as ExtensionContext;
+	const host: FakePiHost = {
+		pi,
+		events,
+		context,
+		setRegisteredServers(servers) {
+			registeredServers = servers;
+		},
+		async emit(event, value) {
+			await Promise.all((handlers.get(event) ?? []).map((handler) => handler(value, context)));
+		},
+	};
+	hosts.push(host);
+	return host;
+}
+
+function discovery(events: EventBusController, requestId: string): McpManagementDiscoveryResponse | undefined {
+	let response: McpManagementDiscoveryResponse | undefined;
+	const unsubscribe = events.on(`${MCP_MANAGEMENT_RESPONSE_EVENT_PREFIX}${requestId}`, (data) => {
+		response = data as McpManagementDiscoveryResponse;
+	});
+	events.emit(MCP_MANAGEMENT_DISCOVERY_EVENT, {
+		protocol: MCP_MANAGEMENT_PROTOCOL_ID,
+		version: MCP_MANAGEMENT_PROTOCOL_VERSION,
+		requestId,
+		requiredCapabilities: [],
+	});
+	unsubscribe();
+	return response;
+}
+
+function install(assembly: McpOwnerAssembly): () => void {
+	const result: McpOwnerAssemblyResult = installMcpOwnerAssembly(assembly);
+	if (!result.ok) throw new Error(`Could not install test assembly: ${result.error.code}`);
+	assemblyDisposers.push(result.value);
+	return result.value;
+}
+
+async function startBuiltInOwner(host: FakePiHost) {
+	nativeMcpExtension(host.pi);
+	await host.emit("session_start", { type: "session_start" });
+	const response = discovery(host.events, `session-${hosts.length}`);
+	if (!response?.result.ok) throw new Error("The built-in MCP owner did not publish its management handle");
+	return response.result.value;
+}
+
+function loadedConfig(servers: McpServerEntry[]): LoadedMcpConfig {
+	return { servers, errors: [] };
+}
+
+const disabledEntry: McpServerEntry = {
