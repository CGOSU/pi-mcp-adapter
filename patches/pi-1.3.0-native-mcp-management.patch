+	setDirectTools(name: string, directTools: McpManagementDirectTools): Promise<McpManagementResult<void>>;
+	/** Applies execution policy to this session only; it does not write configuration. */
+	setExecutionPolicy(name: string, policy: McpManagementExecutionPolicy): Promise<McpManagementResult<void>>;
