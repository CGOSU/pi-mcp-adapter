+		const firstAssembly: McpOwnerAssembly = { loadConfig: () => loadedConfig([]) };
+		const first = installMcpOwnerAssembly(firstAssembly);
+		if (!first.ok) throw new Error("Expected the first owner assembly to install");
+		const same = installMcpOwnerAssembly(firstAssembly);
+		expect(same).toEqual({ ok: true, value: first.value });
+		expect(installMcpOwnerAssembly({ loadConfig: () => loadedConfig([disabledEntry]) })).toMatchObject({
