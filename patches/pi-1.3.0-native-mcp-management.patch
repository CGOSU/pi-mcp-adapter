+
+		await result.host.emit("tool_call", { toolName: "tool_search", input: {} }, result.context);
+
+		expect(result.transportCount()).toBe(1);
+		expect(result.host.tools.has("mcp__docs__search")).toBe(true);
+		expect(snapshot(result.handle)[0]?.catalog.freshness).toBe("live");
+	});
+
+	it("disconnects an idle lazy server and resolves later tool execution through the new connection", async () => {
+		const entry: McpServerEntry = {
+			name: "docs",
+			config: { command: "fixture", lifecycle: "lazy", idleTimeout: 0.005 },
+			source: "fixture",
+		};
+		const result = await setup({ entries: [entry] });
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.catalog.freshness).toBe("live"));
+		const registered = result.host.tools.get("mcp__docs__search") as {
+			execute(id: string, params: unknown, signal: AbortSignal): Promise<{ content: Array<{ text?: string }> }>;
+		};
+		await vi.waitFor(() => expect(snapshot(result.handle)[0]?.connectionStatus).toBe("disconnected"), {
+			timeout: 2_000,
+		});
+		expect(snapshot(result.handle)[0]).toMatchObject({
