+			install({
+				loadConfig: () =>
+					loadedConfig([
+						{ name, config: { url: server.url }, source: "/synthetic/adapter/mcp.json", scope: "global" },
+					]),
+				credentialsBackend,
+			});
+			const host = createFakePiHost();
+			const handle = await startBuiltInOwner(host);
+			await vi.waitFor(() => expect(server.log).toContain("401 none"), { timeout: 5_000 });
+			let authorizationShown!: () => void;
+			const shown = new Promise<void>((resolve) => {
+				authorizationShown = resolve;
+			});
+			const signIn = handle.signIn(name, {
+				showAuthorizationUrl: () => authorizationShown(),
+				promptForRedirectUrl: (signal) =>
+					new Promise((resolve) => signal.addEventListener("abort", () => resolve(undefined), { once: true })),
+			});
+			await shown;
+			await host.emit("session_shutdown", { type: "session_shutdown", reason: "quit" });
+			const writesAfterShutdown = writes;
+
+			expect(await signIn).toMatchObject({ ok: false, error: { code: "session-ended" } });
+			expect(writes).toBe(writesAfterShutdown);
+			expect(credentialsBackend.tokens(name, server.url)).toBeUndefined();
+		} finally {
+			await server.close();
+		}
+	});
+
+	it("keeps a session's resolved assembly until shutdown and removes its discovery listener", async () => {
+		const dispose = install({ loadConfig: () => loadedConfig([disabledEntry]) });
+		const host = createFakePiHost();
+		const previous = await startBuiltInOwner(host);
+		dispose();
+		expect(previous.snapshot()).toMatchObject({ ok: true, value: { servers: [{ name: "assembled" }] } });
+
+		await host.emit("session_shutdown", { type: "session_shutdown", reason: "quit" });
+		expect(previous.snapshot()).toMatchObject({ ok: false, error: { code: "session-ended" } });
+		const afterShutdown: McpManagementDiscoveryResponse[] = [];
+		const unsubscribe = host.events.on(`${MCP_MANAGEMENT_RESPONSE_EVENT_PREFIX}after-shutdown`, (data) => {
+			afterShutdown.push(data as McpManagementDiscoveryResponse);
+		});
+		host.events.emit(MCP_MANAGEMENT_DISCOVERY_EVENT, {
+			protocol: MCP_MANAGEMENT_PROTOCOL_ID,
+			version: MCP_MANAGEMENT_PROTOCOL_VERSION,
+			requestId: "after-shutdown",
+			requiredCapabilities: [],
+		});
+		unsubscribe();
+		expect(afterShutdown).toEqual([]);
+
+		await host.emit("session_start", { type: "session_start" });
+		const nextResponses: McpManagementDiscoveryResponse[] = [];
+		const nextUnsubscribe = host.events.on(`${MCP_MANAGEMENT_RESPONSE_EVENT_PREFIX}next-session`, (data) => {
+			nextResponses.push(data as McpManagementDiscoveryResponse);
+		});
+		host.events.emit(MCP_MANAGEMENT_DISCOVERY_EVENT, {
+			protocol: MCP_MANAGEMENT_PROTOCOL_ID,
+			version: MCP_MANAGEMENT_PROTOCOL_VERSION,
+			requestId: "next-session",
+			requiredCapabilities: [],
+		});
+		nextUnsubscribe();
+		expect(nextResponses).toHaveLength(1);
+		const negotiated = nextResponses[0]?.result;
+		expect(negotiated?.ok).toBe(true);
+		if (!negotiated?.ok) throw new Error("Expected the next session to have one MCP owner");
+		expect(negotiated.value.snapshot()).toMatchObject({ ok: true, value: { servers: [] } });
+	});
+});
diff --git a/packages/coding-agent/test/mcp-request-headers-command.test.ts b/packages/coding-agent/test/mcp-request-headers-command.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6f79a4aa4608b097b906334b5e27a4ba57a9d8de
--- /dev/null
+++ b/packages/coding-agent/test/mcp-request-headers-command.test.ts
@@ -0,0 +1,104 @@
+import process from "node:process";
+import { StreamableHttpTransport } from "@earendil-works/pi-mcp";
+import { describe, expect, it } from "vitest";
+import { createRequestHeadersCommandFetch } from "../src/extensions/mcp/request-headers-command.ts";
+
+const signerScript = `
+let input = "";
+for await (const chunk of process.stdin) input += chunk;
+const request = JSON.parse(input);
+process.stdout.write(JSON.stringify({
+  authorization: "Signed " + request.method + ":" + request.bodyBase64,
+  "x-signed-url": request.url
+}));
+`;
+
+describe("native MCP per-request headers command", () => {
+	it("runs for each exact request and lets derived headers replace static headers", async () => {
+		const sent: Array<{ headers: Headers; body: Buffer | undefined }> = [];
+		const fetch = createRequestHeadersCommandFetch(
+			{ command: process.execPath, args: ["-e", signerScript] },
+			async (_input, init) => {
+				sent.push({
+					headers: new Headers(init?.headers),
+					body: init?.body ? Buffer.from(init.body as Uint8Array) : undefined,
+				});
+				return new Response(null, { status: 204 });
+			},
+		);
+
+		await fetch("https://signer.example/mcp", {
+			method: "POST",
+			headers: { authorization: "Bearer static" },
+			body: "one",
+		});
+		await fetch("https://signer.example/mcp", {
+			method: "POST",
+			headers: { authorization: "Bearer static" },
+			body: "two",
+		});
+
+		expect(sent).toHaveLength(2);
+		expect(sent[0]?.headers.get("authorization")).toBe("Signed POST:b25l");
+		expect(sent[1]?.headers.get("authorization")).toBe("Signed POST:dHdv");
+		expect(sent[0]?.headers.get("x-signed-url")).toBe("https://signer.example/mcp");
+		expect(sent[0]?.body?.toString("utf8")).toBe("one");
+		expect(sent[1]?.body?.toString("utf8")).toBe("two");
+	});
+
+	it("aborts the signer when a Streamable request stops waiting before dispatch", async () => {
+		let requestsSent = 0;
+		const fetch = createRequestHeadersCommandFetch(
+			{
+				command: process.execPath,
+				args: ["-e", "process.stdin.resume(); setTimeout(() => {}, 10000);"],
+				timeoutMs: 5_000,
+			},
+			async () => {
+				requestsSent++;
+				return new Response(null, { status: 202 });
+			},
+		);
+		const transport = new StreamableHttpTransport({ url: "https://signer.example/mcp", fetch, openGetStream: false });
+		await transport.start();
+		const controller = new AbortController();
+		const request = transport.send(
+			{ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: "fixture", arguments: {} } },
+			{ signal: controller.signal },
+		);
+		await new Promise((resolve) => setTimeout(resolve, 100));
+		controller.abort();
+		await expect(request).rejects.toThrow();
+		expect(requestsSent).toBe(0);
+		await transport.close();
+	});
+
+	it("fails closed on signer errors and timeouts without sending the HTTP request", async () => {
+		let requestsSent = 0;
+		const failed = createRequestHeadersCommandFetch(
+			{
+				command: process.execPath,
+				args: ["-e", "process.stdin.resume(); process.stdin.on('end', () => process.exit(17));"],
+			},
+			async () => {
+				requestsSent++;
+				return new Response(null, { status: 204 });
+			},
+		);
+		await expect(failed("https://signer.example/mcp")).rejects.toThrow("exited with code 17");
+
+		const timedOut = createRequestHeadersCommandFetch(
+			{
+				command: process.execPath,
+				args: ["-e", "process.stdin.resume(); setTimeout(() => {}, 10000);"],
+				timeoutMs: 100,
+			},
+			async () => {
+				requestsSent++;
+				return new Response(null, { status: 204 });
+			},
+		);
+		await expect(timedOut("https://signer.example/mcp")).rejects.toThrow("timed out after 100ms");
+		expect(requestsSent).toBe(0);
+	});
+});
diff --git a/packages/coding-agent/test/mcp-resources-policy.test.ts b/packages/coding-agent/test/mcp-resources-policy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ca914f0f259e505831d816da30493ce56bae6f64
--- /dev/null
+++ b/packages/coding-agent/test/mcp-resources-policy.test.ts
@@ -0,0 +1,101 @@
+import { describe, expect, it, vi } from "vitest";
+import type { McpServerEntry } from "../src/extensions/mcp/config.ts";
+import { createMcpResourceToolDefinitions, type McpResourceServer } from "../src/extensions/mcp/resources.ts";
+
+const resources = [
+	{ uri: "file:///public", name: "public-schema", mimeType: "text/plain" },
+	{ uri: "file:///secret", name: "secret", mimeType: "text/plain" },
+	{ uri: "ui://application", name: "app", mimeType: "text/html;profile=mcp-app" },
+];
+
+function fixture(executionPolicy: NonNullable<McpServerEntry["executionPolicy"]> = {}) {
+	const sequence: string[] = [];
+	const server = {
+		name: "docs",
+		entry: {
+			name: "docs",
+			config: { command: "fixture" },
+			executionPolicy,
+			source: "/tmp/mcp-resources-policy-test/mcp.json",
+			scope: "global",
+		} as McpServerEntry,
+		timeoutMs: 1000,
+		resourcesPage: vi.fn(async () => ({ resources, nextCursor: undefined })),
+		resourceTemplatesPage: vi.fn(async () => ({ resourceTemplates: [] })),
+		allResources: vi.fn(async () => resources),
+		allResourceTemplates: vi.fn(async () => []),
+		readResource: vi.fn(async (uri: string) => ({
+			contents: [{ uri, mimeType: "text/plain", text: "public content" }],
+		})),
+	} as unknown as McpResourceServer & Record<string, any>;
+	const authorizeRead = vi.fn(async (_server: McpResourceServer, _toolName: string, _uri: string) => {
+		sequence.push("approved");
+	});
+	const definitions = createMcpResourceToolDefinitions({
+		exposure: "direct",
+		servers: () => [server],
+		allTools: () => [],
+		authorizeRead,
+	});
+	const tool = (name: string) => {
+		const definition = definitions.find((candidate) => candidate.name === name);
+		if (!definition) throw new Error(`Missing resource tool ${name}`);
+		return definition as unknown as {
+			execute(toolCallId: string, params: unknown, signal: AbortSignal): Promise<{ structuredContent?: unknown }>;
+		};
+	};
+	server.readResource.mockImplementation(async (uri: string) => {
+		sequence.push("read");
+		return { contents: [{ uri, mimeType: "text/plain", text: "public content" }] };
+	});
+	return { server, authorizeRead, sequence, tool };
+}
+
+describe("native MCP resource execution policies", () => {
+	it("does not contact servers whose resource exposure is disabled", async () => {
+		const { server, tool } = fixture({ exposeResources: false });
+		const list = await tool("list_mcp_resources").execute("list", {}, new AbortController().signal);
+		expect(list.structuredContent).toMatchObject({ resources: [] });
+		expect(server.resourcesPage).not.toHaveBeenCalled();
+		expect(server.allResources).not.toHaveBeenCalled();
+		await expect(
+			tool("read_mcp_resource").execute(
+				"read",
+				{ server: "docs", uri: "file:///public" },
+				new AbortController().signal,
+			),
+		).rejects.toThrow("has no resources");
+		expect(server.readResource).not.toHaveBeenCalled();
+	});
+
+	it("filters listed resources and verifies policy before reading content", async () => {
+		const { server, authorizeRead, sequence, tool } = fixture({
+			includeTools: ["docs_public_schema"],
+			excludeTools: ["docs_secret"],
+			outputGuard: { maxBytes: 1024, detailsMaxBytes: 1024 },
+		});
+		const listing = await tool("list_mcp_resources").execute(
+			"list",
+			{ server: "docs" },
+			new AbortController().signal,
+		);
+		expect(listing.structuredContent).toMatchObject({
+			resources: [{ server: "docs", uri: "file:///public", name: "public-schema" }],
+		});
+		expect(JSON.stringify(listing.structuredContent)).not.toContain("file:///secret");
+		expect(JSON.stringify(listing.structuredContent)).not.toContain("ui://application");
+
+		const read = tool("read_mcp_resource");
+		await expect(
+			read.execute("read-public", { server: "docs", uri: "file:///public" }, new AbortController().signal),
+		).resolves.toMatchObject({ structuredContent: { server: "docs", uri: "file:///public" } });
+		expect(authorizeRead).toHaveBeenCalledWith(server, "public_schema", "file:///public", expect.any(AbortSignal));
+		expect(sequence).toEqual(["approved", "read"]);
+
+		await expect(
+			read.execute("read-secret", { server: "docs", uri: "file:///secret" }, new AbortController().signal),
+		).rejects.toThrow("not available");
+		expect(authorizeRead).toHaveBeenCalledTimes(1);
+		expect(server.readResource).toHaveBeenCalledTimes(1);
+	});
+});
diff --git a/packages/coding-agent/test/mcp-sampling.test.ts b/packages/coding-agent/test/mcp-sampling.test.ts
