+		protocol: options.protocol ?? MCP_MANAGEMENT_PROTOCOL_ID,
+		version: options.version ?? MCP_MANAGEMENT_PROTOCOL_VERSION,
+		requestId,
+		requiredCapabilities: options.requiredCapabilities ?? [],
