new file mode 100644
index 0000000000000000000000000000000000000000..ba65ae33f1c4aea04b47e9d54dc5e2b5b43ddccf
--- /dev/null
+++ b/packages/coding-agent/src/extensions/mcp/sampling.ts
@@ -0,0 +1,371 @@
+import type { Api, AssistantMessage, Message, Model, ProviderHeaders, TextContent } from "@earendil-works/pi-ai";
+import type { McpClient } from "@earendil-works/pi-mcp";
+import { JSON_RPC_ERROR_CODES, McpError } from "@earendil-works/pi-mcp";
+import type { ExtensionUIContext } from "../../core/extensions/types.ts";
+import type { ModelRegistry } from "../../core/model-registry.ts";
+
+export interface McpSamplingHandlerOptions {
+	readonly serverName: string;
+	readonly autoApprove: boolean;
+	readonly ui?: Pick<ExtensionUIContext, "confirm">;
+	readonly modelRegistry?: Pick<ModelRegistry, "getAvailable" | "getApiKeyAndHeaders">;
+	readonly getCurrentModel: () => Model<Api> | undefined;
+	readonly isModelAllowed?: (model: Model<Api>) => boolean;
+}
+
+interface SamplingMessage {
+	readonly role: "user" | "assistant";
+	readonly content: string | readonly { readonly type: string; readonly text?: string }[];
+}
+
+interface SamplingParams {
+	readonly messages: readonly SamplingMessage[];
+	readonly maxTokens: number;
+	readonly systemPrompt?: string;
+	readonly modelPreferences?: { readonly hints?: readonly { readonly name?: string }[] };
+	readonly temperature?: number;
+	readonly metadata?: Record<string, unknown>;
+	readonly includeContext?: string;
+	readonly tools?: readonly unknown[];
+	readonly toolChoice?: unknown;
+	readonly stopSequences?: readonly string[];
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function invalidParams(message: string): McpError {
+	return new McpError(JSON_RPC_ERROR_CODES.invalidParams, message);
+}
+
+function parseSamplingParams(value: unknown): SamplingParams {
+	if (
+		!isRecord(value) ||
+		!Array.isArray(value.messages) ||
+		value.messages.length === 0 ||
+		value.messages.length > 128
+	) {
+		throw invalidParams("MCP sampling requires between 1 and 128 messages.");
+	}
+	if (typeof value.maxTokens !== "number" || !Number.isSafeInteger(value.maxTokens) || value.maxTokens < 1) {
+		throw invalidParams("MCP sampling maxTokens must be a positive safe integer.");
+	}
+	if (value.includeContext !== undefined && value.includeContext !== "none") {
+		throw invalidParams("MCP sampling context inclusion is not supported.");
+	}
+	if (value.tools !== undefined && (!Array.isArray(value.tools) || value.tools.length > 0)) {
+		throw invalidParams("MCP sampling tool use is not supported.");
+	}
+	if (value.toolChoice !== undefined) throw invalidParams("MCP sampling tool choice is not supported.");
+	if (
+		value.stopSequences !== undefined &&
+		(!Array.isArray(value.stopSequences) || value.stopSequences.some((item) => typeof item !== "string"))
+	) {
+		throw invalidParams("MCP sampling stopSequences must be an array of strings.");
+	}
+	if (Array.isArray(value.stopSequences) && value.stopSequences.length > 0) {
+		throw invalidParams("MCP sampling stop sequences are not supported.");
+	}
+	if (value.modelPreferences !== undefined) {
+		if (!isRecord(value.modelPreferences)) throw invalidParams("MCP sampling modelPreferences must be an object.");
+		const hints = value.modelPreferences.hints;
+		if (
+			hints !== undefined &&
+			(!Array.isArray(hints) ||
+				hints.length > 16 ||
+				hints.some(
+					(hint) =>
+						!isRecord(hint) ||
+						(hint.name !== undefined && (typeof hint.name !== "string" || hint.name.length > 256)),
+				))
+		) {
+			throw invalidParams("MCP sampling modelPreferences.hints must contain at most 16 bounded model names.");
+		}
+	}
+	if (value.metadata !== undefined) {
+		if (!isRecord(value.metadata)) throw invalidParams("MCP sampling metadata must be an object.");
+		try {
+			if (Buffer.byteLength(JSON.stringify(value.metadata), "utf8") > 64 * 1024) {
+				throw invalidParams("MCP sampling metadata exceeds the 64 KiB limit.");
+			}
+		} catch (error) {
+			if (error instanceof McpError) throw error;
+			throw invalidParams("MCP sampling metadata must be JSON serializable.");
+		}
+	}
+	if (
+		value.temperature !== undefined &&
+		(typeof value.temperature !== "number" || !Number.isFinite(value.temperature))
+	) {
+		throw invalidParams("MCP sampling temperature must be a finite number.");
+	}
+	if (value.systemPrompt !== undefined && typeof value.systemPrompt !== "string") {
+		throw invalidParams("MCP sampling systemPrompt must be a string.");
+	}
+	const messages = value.messages.map((message): SamplingMessage => {
+		if (!isRecord(message) || (message.role !== "user" && message.role !== "assistant")) {
+			throw invalidParams("MCP sampling messages must have user or assistant roles.");
+		}
+		const content = message.content;
+		if (typeof content === "string") return { role: message.role, content };
+		if (
+			!Array.isArray(content) ||
+			content.length > 128 ||
+			content.some((block) => !isRecord(block) || block.type !== "text" || typeof block.text !== "string")
+		) {
+			throw invalidParams("Only text content is supported in MCP sampling messages.");
+		}
+		return {
+			role: message.role,
+			content: content.map((block) => ({ type: "text", text: (block as { text: string }).text })),
+		};
+	});
+	const messageBytes = messages.reduce(
+		(total, message) =>
+			total +
+			Buffer.byteLength(
+				typeof message.content === "string"
+					? message.content
+					: message.content.map((block) => block.text ?? "").join("\n"),
+				"utf8",
+			),
+		0,
+	);
+	if (messageBytes > 512 * 1024) throw invalidParams("MCP sampling message content exceeds the 512 KiB limit.");
+	if (typeof value.systemPrompt === "string" && Buffer.byteLength(value.systemPrompt, "utf8") > 32 * 1024) {
+		throw invalidParams("MCP sampling systemPrompt exceeds the 32 KiB limit.");
+	}
+	return {
+		messages,
+		maxTokens: value.maxTokens,
+		...(value.systemPrompt === undefined ? {} : { systemPrompt: value.systemPrompt }),
+		...(isRecord(value.modelPreferences)
+			? { modelPreferences: value.modelPreferences as SamplingParams["modelPreferences"] }
+			: {}),
+		...(value.temperature === undefined ? {} : { temperature: value.temperature }),
+		...(isRecord(value.metadata) ? { metadata: value.metadata } : {}),
+		...(value.includeContext === undefined ? {} : { includeContext: value.includeContext }),
+		...(Array.isArray(value.tools) ? { tools: value.tools } : {}),
+		...(value.toolChoice === undefined ? {} : { toolChoice: value.toolChoice }),
+		...(Array.isArray(value.stopSequences) ? { stopSequences: value.stopSequences as string[] } : {}),
+	};
+}
+
+function throwIfAborted(signal: AbortSignal): void {
+	if (signal.aborted)
+		throw signal.reason instanceof Error
+			? signal.reason
+			: Object.assign(new Error("MCP sampling was cancelled."), { name: "AbortError" });
+}
+
+async function awaitWithSignal<T>(promise: Promise<T>, signal: AbortSignal): Promise<T> {
+	throwIfAborted(signal);
+	let onAbort: (() => void) | undefined;
+	try {
+		return await Promise.race([
+			promise,
+			new Promise<T>((_resolve, reject) => {
+				onAbort = () =>
+					reject(
+						signal.reason instanceof Error
+							? signal.reason
+							: Object.assign(new Error("MCP sampling was cancelled."), { name: "AbortError" }),
+					);
+				signal.addEventListener("abort", onAbort, { once: true });
+			}),
+		]);
+	} finally {
+		if (onAbort) signal.removeEventListener("abort", onAbort);
+	}
+}
+
+function sanitize(text: string): string {
+	return text
+		.replace(/\x1b\][^\x07]*(?:\x07|\x1b\\)/g, "")
+		.replace(/(?:\x1b\[[0-?]*[ -/]*[@-~]|\x1b[@-Z\\-_])/g, "")
+		.replace(/[\u0000-\u001f\u007f-\u009f]/g, " ");
+}
+
+function messageText(message: Message): string {
+	if (typeof message.content === "string") return message.content;
+	return message.content.map((block) => (block.type === "text" ? block.text : `[${block.type}]`)).join("\n");
+}
+
+function formatRequest(server: string, model: string, systemPrompt: string | undefined, messages: Message[]): string {
+	const lines = [
+		`${server} wants to sample ${messages.length} message${messages.length === 1 ? "" : "s"} with ${model}.`,
+	];
+	if (systemPrompt) lines.push(`System: ${systemPrompt.slice(0, 400)}`);
+	for (const [index, message] of messages.entries())
+		lines.push(`${index + 1}. ${message.role}: ${messageText(message).slice(0, 400)}`);
+	return sanitize(lines.join("\n\n"));
+}
+
+async function confirm(
+	options: McpSamplingHandlerOptions,
+	title: string,
+	message: string,
+	signal: AbortSignal,
+): Promise<void> {
+	throwIfAborted(signal);
+	if (options.autoApprove) return;
+	if (!options.ui)
+		throw new Error("MCP sampling requires interactive approval; it is not allowed in a headless session.");
+	const approved = await awaitWithSignal(options.ui.confirm(title, message, { signal }), signal);
+	if (!approved) throw new Error("MCP sampling request was declined.");
+}
+
+function toMessage(message: SamplingMessage, model: Model<Api>): Message {
+	const text =
+		typeof message.content === "string"
+			? message.content
+			: message.content.map((block) => block.text ?? "").join("\n");
+	if (message.role === "user") return { role: "user", content: [{ type: "text", text }], timestamp: Date.now() };
+	return {
+		role: "assistant",
+		content: [{ type: "text", text }],
+		api: model.api,
+		provider: model.provider,
+		model: model.id,
+		usage: zeroUsage(),
+		stopReason: "stop",
+		timestamp: Date.now(),
+	};
+}
+
+async function resolveModel(
+	options: McpSamplingHandlerOptions,
+	hints: SamplingParams["modelPreferences"],
+): Promise<{
+	model: Model<Api>;
+	apiKey?: string;
+	headers?: ProviderHeaders;
+}> {
+	const registry = options.modelRegistry;
+	if (!registry) throw new Error("No Pi model registry is available for MCP sampling.");
+	const candidates: Model<Api>[] = [];
+	const allowed = (model: Model<Api>) => options.isModelAllowed?.(model) !== false;
+	const add = (model: Model<Api> | undefined) => {
+		if (
+			model &&
+			allowed(model) &&
+			!candidates.some((candidate) => candidate.provider === model.provider && candidate.id === model.id)
+		)
+			candidates.push(model);
+	};
+	for (const hint of hints?.hints ?? []) {
+		const normalized = hint.name?.trim().toLowerCase();
+		if (!normalized) continue;
+		for (const model of registry.getAvailable()) {
+			if (
+				allowed(model) &&
+				[`${model.provider}/${model.id}`, model.id, model.name].some((name) =>
+					name.toLowerCase().includes(normalized),
+				)
+			)
+				add(model);
+		}
+	}
+	add(options.getCurrentModel());
+	for (const model of registry.getAvailable()) add(model);
+	const failures: string[] = [];
+	for (const model of candidates) {
+		const auth = await registry.getApiKeyAndHeaders(model);
+		if (auth.ok === false) failures.push(`${model.provider}/${model.id}: ${auth.error}`);
+		else
+			return {
+				model,
+				...(auth.apiKey === undefined ? {} : { apiKey: auth.apiKey }),
+				...(auth.headers === undefined ? {} : { headers: auth.headers }),
+			};
+	}
+	if (failures.length) throw new Error(`No configured auth for MCP sampling model. ${failures.join("; ")}`);
+	throw new Error("No Pi model is available for MCP sampling.");
+}
+
+function zeroUsage(): AssistantMessage["usage"] {
+	return {
+		input: 0,
+		output: 0,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 0,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	};
+}
+
+function samplingResult(message: AssistantMessage): {
+	role: "assistant";
+	content: { type: "text"; text: string };
+	model: string;
+	stopReason: "endTurn" | "maxTokens" | "toolUse";
+} {
+	if (message.stopReason === "error" || message.stopReason === "aborted") {
+		throw new Error(message.errorMessage ?? "MCP sampling model call failed.");
+	}
+	if (
+		message.stopReason === "toolUse" ||
+		message.content.some((block) => block.type !== "text" && block.type !== "thinking")
+	) {
+		throw new Error("MCP sampling tool calls or non-text response content are not supported.");
+	}
+	const text = message.content
+		.filter((block): block is TextContent => block.type === "text")
+		.map((block) => block.text)
+		.join("\n\n")
+		.trim();
+	if (!text) throw new Error("MCP sampling result did not contain text content.");
+	const stopReason =
+		message.stopReason === "stop" ? "endTurn" : message.stopReason === "length" ? "maxTokens" : "toolUse";
+	return {
+		role: "assistant",
+		content: { type: "text", text },
+		model: `${message.provider}/${message.model}`,
+		stopReason,
+	};
+}
+
+export function registerMcpSamplingHandler(client: McpClient, options: McpSamplingHandlerOptions): void {
+	client.setRequestHandler("sampling/createMessage", async (value, context) => {
+		const params = parseSamplingParams(value);
+		const signal = context.signal;
+		throwIfAborted(signal);
+		const { model, apiKey, headers } = await resolveModel(options, params.modelPreferences);
+		if (params.maxTokens > model.maxTokens) {
+			throw invalidParams(`MCP sampling maxTokens exceeds the selected model maximum of ${model.maxTokens}.`);
+		}
+		const messages = params.messages.map((message) => toMessage(message, model));
+		throwIfAborted(signal);
+		await confirm(
+			options,
+			"Approve MCP sampling request",
+			formatRequest(options.serverName, `${model.provider}/${model.id}`, params.systemPrompt, messages),
+			signal,
+		);
+		const { complete } = await import("@earendil-works/pi-ai/compat");
+		const result = await complete(
+			model,
+			{ ...(params.systemPrompt === undefined ? {} : { systemPrompt: params.systemPrompt }), messages },
+			{
+				...(apiKey === undefined ? {} : { apiKey }),
+				...(headers === undefined ? {} : { headers }),
+				maxTokens: params.maxTokens,
+				...(params.temperature === undefined ? {} : { temperature: params.temperature }),
+				...(params.metadata === undefined ? {} : { metadata: params.metadata }),
+				signal,
+			},
+		);
+		throwIfAborted(signal);
+		const response = samplingResult(result);
+		await confirm(
+			options,
+			"Return MCP sampling response",
+			sanitize(
+				`${options.serverName} will receive this response from ${response.model}:\n\n${response.content.text.slice(0, 1000)}`,
+			),
+			signal,
+		);
+		return response;
+	});
+}
