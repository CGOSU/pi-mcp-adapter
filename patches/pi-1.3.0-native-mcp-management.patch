+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { McpServerEntry } from "../src/extensions/mcp/config.ts";
+import {
+	assignAdapterToolName,
+	effectiveMcpToolExposure,
+	formatAdapterToolName,
+	hasDirectMcpToolSelection,
+	isMcpToolAllowed,
+	isMcpToolSelectedForDirectExposure,
+	type McpToolCandidate,
+	resourceToolName,
+	searchKeywordsForTool,
+} from "../src/extensions/mcp/execution-policy.ts";
+
+function server(
+	name: string,
+	executionPolicy: NonNullable<McpServerEntry["executionPolicy"]>,
+	config: Record<string, unknown> = { command: "fixture" },
+): McpServerEntry {
+	return {
+		name,
+		config: config as McpServerEntry["config"],
+		executionPolicy,
+		source: "/tmp/mcp-execution-policy-test/mcp.json",
+		scope: "global",
+	};
+}
+
+afterEach(() => vi.unstubAllEnvs());
+
+describe("native MCP execution policy", () => {
+	it("uses MCP_DIRECT_TOOLS server and tool selectors as a live override", () => {
+		vi.stubEnv("MCP_DIRECT_TOOLS", "docs,search/read_file/");
+		const docs = server("docs", { directTools: ["other"] });
+		const search = server("search", { directTools: true });
+
+		expect(hasDirectMcpToolSelection(docs)).toBe(true);
+		expect(isMcpToolSelectedForDirectExposure(docs, "find")).toBe(true);
+		expect(hasDirectMcpToolSelection(search)).toBe(true);
+		expect(isMcpToolSelectedForDirectExposure(search, "read_file")).toBe(true);
+		expect(isMcpToolSelectedForDirectExposure(search, "write_file")).toBe(false);
+	});
+
+	it("lets the explicit empty environment override disable configured direct tools", () => {
+		vi.stubEnv("MCP_DIRECT_TOOLS", "__none__");
+		const entry = server("docs", { directTools: true });
+
+		expect(hasDirectMcpToolSelection(entry)).toBe(false);
+		expect(isMcpToolSelectedForDirectExposure(entry, "search")).toBe(false);
+	});
+
+	it("filters include and exclude selectors with current and unambiguous legacy names", () => {
+		const entry = server("docs", {
+			toolPrefix: "server",
+			includeTools: ["docs_read_file"],
+			excludeTools: ["docs_read_file_secret"],
+		});
+		const tools: McpToolCandidate[] = [
+			{ server: entry, name: "read-file" },
+			{ server: entry, name: "read-file-secret" },
+		];
+
+		expect(isMcpToolAllowed(entry, "read-file", tools)).toBe(true);
+		expect(isMcpToolAllowed(entry, "read-file-secret", tools)).toBe(false);
+		expect(isMcpToolAllowed(entry, "unlisted", tools)).toBe(false);
+	});
+
+	it("keeps hidden exposure authoritative while promoting only selected tools", () => {
+		const entry = server(
+			"docs",
+			{ directTools: ["search"] },
+			{
+				command: "fixture",
+				exposure: "codemode",
+				toolExposure: { hidden: "hidden" },
+			},
+		);
+
+		expect(effectiveMcpToolExposure(entry, "search")).toBe("direct");
+		expect(effectiveMcpToolExposure(entry, "other")).toBe("codemode");
+		expect(effectiveMcpToolExposure(entry, "hidden")).toBe("hidden");
+	});
+
+	it("produces stable bounded tool names and resolves collisions deterministically", () => {
+		const policy = { toolPrefix: "none" as const };
+		const first = assignAdapterToolName("one", "search", policy, () => false);
+		const collision = assignAdapterToolName("two", "search", policy, (name) => name === "search");
+
+		expect(formatAdapterToolName("docs-mcp", "read.file", { toolPrefix: "mcp" })).toBe("mcp__docs-mcp_read_file");
+		expect(first).toBe("search");
+		expect(collision).toMatch(/^search_[a-f0-9]{8}$/);
+		expect(collision).toBe(assignAdapterToolName("two", "search", policy, () => true));
+		expect(
+			assignAdapterToolName("server".repeat(30), "tool".repeat(30), { toolPrefix: "server" }, () => true),
+		).toHaveLength(64);
+	});
+
+	it("filters resource exposure and derives stable resource tool names", () => {
+		const hiddenResources = server("docs", { exposeResources: false });
+		const selectedResources = server("docs", { includeTools: ["docs_schema"] });
+		const tools: McpToolCandidate[] = [];
+
+		expect(isMcpToolAllowed(hiddenResources, "schema", tools, true)).toBe(false);
+		expect(isMcpToolAllowed(selectedResources, "schema", tools, true)).toBe(true);
+		expect(resourceToolName("Database Schema/v2")).toBe("database_schema_v2");
+		expect(resourceToolName("123")).toBe("resource_123");
+	});
+
+	it("keeps search keywords as selector metadata only", () => {
+		const entry = server("docs", {
+			toolPrefix: "server",
+			searchKeywords: { docs_search: ["documentation", "reference"], "docs_search*": ["workspace"] },
+		});
+		const tools: McpToolCandidate[] = [{ server: entry, name: "search" }];
+
+		expect(searchKeywordsForTool(entry, "search", tools)).toEqual(["documentation", "reference", "workspace"]);
+		expect(searchKeywordsForTool(entry, "write", tools)).toEqual([]);
+	});
+});
