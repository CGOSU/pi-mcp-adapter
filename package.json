{
  "name": "pi-mcp-adapter",
  "version": "2.27.0",
  "description": "MCP (Model Context Protocol) adapter extension for Pi coding agent",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./oauth": {
      "types": "./oauth.ts",
      "import": "./oauth.ts",
      "default": "./oauth.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./metadata-cache": {
      "types": "./dist/metadata-cache.d.ts",
      "import": "./dist/metadata-cache.js",
      "default": "./dist/metadata-cache.js"
    }
  },
  "license": "MIT",
  "author": "Nico Bailon",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pi-mcp-adapter": "cli.js"
  },
  "scripts": {
    "build:public": "tsc -p tsconfig.public.json",
    "prepack": "npm run build:public",
    "typecheck": "tsc --noEmit",
    "test": "node test-runner.mjs",
    "test:vitest": "vitest run",
    "test:public-exports": "npm run build:public && node --test test/node/package/public-exports.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:oauth": "node test/node/run-auth-tests.mjs",
    "test:oauth-provider": "node test/node/run-auth-tests.mjs --provider-only",
    "test:conformance": "bash conformance/run.sh",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "benchmark:catalog": "node --import tsx scripts/benchmark-catalog.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "video": "https://github.com/nicobailon/pi-mcp-adapter/raw/refs/heads/main/pi-mcp.mp4"
  },
  "files": [
    "cli.js",
    "index.ts",
    "src",
    "config.ts",
    "metadata-cache.ts",
    "types.ts",
    "oauth.ts",
    "banner.png",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "recheck": "^4.5.0",
    "smol-toml": "^1.6.1",
    "strip-json-comments": "^5.0.3",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/bun": "^1.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "@types/open": "^6.2.1",
    "tsx": "^4.21.0",
    "typebox": "1.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
