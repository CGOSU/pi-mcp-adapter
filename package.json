{
  "name": "pi-mcp-adapter",
  "version": "2.27.1",
  "description": "MCP (Model Context Protocol) adapter extension for Pi coding agent",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js",
      "default": "./dist/oauth.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./metadata-cache": {
      "types": "./dist/metadata-cache.d.ts",
      "import": "./dist/metadata-cache.js",
      "default": "./dist/metadata-cache.js"
    }
  },
  "license": "MIT",
  "author": "Nico Bailon",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-mcp-adapter": "dist/cli.js"
  },
  "scripts": {
    "build:public": "node scripts/build-public.mjs",
    "prepack": "npm run build:public",
    "typecheck": "tsc --noEmit",
    "test": "node test-runner.mjs",
    "test:vitest": "vitest run",
    "test:public-exports": "npm run build:public && node --test test/node/package/public-exports.test.mjs test/node/package/build-artifacts.test.mjs test/node/package/package-tarball.test.mjs",
    "test:public-types": "node scripts/test-patched-public-types.mjs",
    "test:patched-native-session": "node scripts/test-patched-native-session.mjs",
    "test:patched-pi-runners": "node --test test/node/package/patched-pi-runners.test.mjs",
    "test:managed-pi-update-hook": "node --test test/node/update/managed-pi-update-hook.test.mjs",
    "install:managed-pi-update-hook": "node scripts/install-managed-pi-update-hook.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:oauth": "node test/node/run-auth-tests.mjs",
    "test:oauth-provider": "node test/node/run-auth-tests.mjs --provider-only",
    "test:conformance": "bash conformance/run.sh",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "benchmark:catalog": "node --import tsx scripts/benchmark-catalog.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "video": "https://github.com/nicobailon/pi-mcp-adapter/raw/refs/heads/main/pi-mcp.mp4"
  },
  "files": [
    "dist",
    "extensions",
    "banner.png",
    "skills",
    "docs/native-mcp-patch.md",
    "docs/native-mcp-protocol.md",
    "patches",
    "scripts/managed-pi-update-hook.mjs",
    "scripts/install-managed-pi-update-hook.mjs",
    "scripts/managed-pi-update-launcher.sh",
    "scripts/managed-pi-update-artifacts.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "recheck": "^4.5.0",
    "strip-json-comments": "^5.0.3",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "typebox": "*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/bun": "^1.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "@types/open": "^6.2.1",
    "esbuild": "0.28.1",
    "tsx": "^4.21.0",
    "typebox": "1.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
